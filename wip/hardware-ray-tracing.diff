+                                    (1, 48) => {
+                                        let dst = inst.writes.first()?.1;
+                                        if !self.uses_only_low_24_bits(dst, scope) {
+                                            meta_fail!(
+                                                "InstId low24 failed at B{b}:{i}@{:#x}",
+                                                self.p.blocks[b].insts[i].machine.offset
+                                            );
+                                        }
+                                        RayMetaKind::InstanceId
+                                    }
+                                    (1, 52) => {
+                                        let dst = inst.writes.first()?.1;
+                                        if !self.uses_only_low_24_bits(dst, scope) {
+                                            meta_fail!(
+                                                "InstContrib low24 failed at B{b}:{i}@{:#x}",
+                                                self.p.blocks[b].insts[i].machine.offset
+                                            );
+                                        }
+                                        RayMetaKind::InstanceContribution
+                                    }
+                                    (1, 60) => {
+                                        let dst = inst.writes.first()?.1;
+                                        if !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            dst,
+                                            BvhTag::BlasBaseShr8,
+                                            v_facts.clone(),
+                                        ) {
+                                            meta_fail!("BlasBaseShr8 clash at B{b}:{i}");
+                                        }
+                                        RayMetaKind::BlasBaseZero
+                                    }
+                                    (1, 112) => RayMetaKind::InstanceIndex,
+                                    (n_dw, t) if t < 48 && t % 4 == 0 && t + 4 * n_dw <= 48 => {
+                                        RayMetaKind::ObjectToWorld(t)
+                                    }
+                                    _ => meta_fail!(
+                                        "InstAddrLo({total}, ndw={ndw}) unsupported load at B{b}:{i}@{:#x}",
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    ),
+                                };
+                                if let Some(&prev) = loads.get(&(b, i))
+                                    && prev != kind
+                                {
+                                    meta_fail!("InstAddrLo load kind clash at B{b}:{i}");
+                                }
+                                loads.insert((b, i), kind);
+                            } else {
+                                meta_fail!(
+                                    "InstAddrLo({off}) used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::AddrHi => {
+                            if matches!(n, "v_add_co_ci_u32" | "s_addc_u32") {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::AddrHi,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("AddrHi addc clash at B{b}:{i}");
+                                }
+                            } else if flat_or_smem_load_hi_only(inst, v) {
+                                // High address word of a replaced `global_load_*` / `s_load_*`: checked via lo word!
+                            } else {
+                                meta_fail!(
+                                    "AddrHi used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::AddrCarry => {
+                            if matches!(n, "v_add_co_ci_u32" | "s_addc_u32") {
+                                let w = inst.writes.first()?.1;
+                                if !tags.contains_key(&w)
+                                    && !set_tag(
+                                        &mut tags,
+                                        &mut tag_facts,
+                                        &mut work,
+                                        w,
+                                        BvhTag::AddrHi,
+                                        v_facts.clone(),
+                                    )
+                                {
+                                    meta_fail!("AddrCarry hi clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "AddrCarry used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::BlasBaseShr8 => {
+                            if matches!(n, "v_lshlrev_b64" | "s_lshl_b64")
+                                && has_const_operand(inst, 8)
+                            {
+                                let lo = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    lo,
+                                    BvhTag::BlasBaseLo,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("BlasBaseLo clash at B{b}:{i}");
+                                }
+                                if let Some(&(_, hi)) = inst.writes.get(1)
+                                    && !set_tag(
+                                        &mut tags,
+                                        &mut tag_facts,
+                                        &mut work,
+                                        hi,
+                                        BvhTag::AddrHi,
+                                        v_facts.clone(),
+                                    )
+                                {
+                                    meta_fail!("AddrHi clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_lshlrev_b32" | "s_lshl_b32")
+                                && other_const_arg(inst, v) == Some(8)
+                            {
+                                let lo = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    lo,
+                                    BvhTag::BlasBaseLo,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("BlasBaseLo32 clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "BlasBaseShr8 used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::BlasBaseLo => {
+                            if matches!(
+                                n,
+                                "v_add_co_u32" | "v_add_nc_u32" | "s_add_u32" | "v_or_b32"
+                            ) {
+                                let other_v = other_val_arg(inst, v)?;
+                                let other_tag = tags.get(&other_v).copied();
+                                let out_tag = match other_tag {
+                                    Some(BvhTag::TriByteOff(off)) => BvhTag::TriAddrLo(off),
+                                    Some(BvhTag::TriByteOffPrim) => BvhTag::TriAddrPrimLo,
+                                    None if round < 5 => {
+                                        deferred.push((v, b, i));
+                                        continue;
+                                    }
+                                    _ => meta_fail!(
+                                        "BlasBaseLo add bad other_tag={other_tag:?} at B{b}:{i}@{:#x}",
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    ),
+                                };
+                                let lo = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    lo,
+                                    out_tag,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!(
+                                        "BlasBaseLo out_tag={out_tag:?} clash (prev={:?}) at B{b}:{i}@{:#x}",
+                                        tags.get(&lo),
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    );
+                                }
+                                for &(wr, wv) in inst.writes.iter().skip(1) {
+                                    if matches!(wr, Reg::S(_) | Reg::Scc)
+                                        && !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            wv,
+                                            BvhTag::AddrCarry,
+                                            v_facts.clone(),
+                                        )
+                                    {
+                                        meta_fail!("BlasBaseLo carry clash at B{b}:{i}");
+                                    }
+                                }
+                            } else {
+                                meta_fail!(
+                                    "BlasBaseLo used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriNode => {
+                            if matches!(n, "v_lshrrev_b32" | "s_lshr_b32")
+                                && other_const_arg(inst, v) == Some(3)
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriNodeShr3,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriNodeShr3 clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_and_b32" | "s_and_b32")
+                                && other_const_arg(inst, v) == Some(7)
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriSlot,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriSlot clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriNode used by {n} at B{b}:{i}@{:#x} v={v:?} def={:?} v_facts={v_facts:?} g={:?} eg={:?}",
+                                    self.p.blocks[b].insts[i].machine.offset,
+                                    self.defs.get(v.0 as usize),
+                                    self.st.guards[b][i],
+                                    self.same_exec_scope_guard(b, i)
+                                );
+                            }
+                        }
+                        BvhTag::TriNodeShr3 => {
+                            if matches!(n, "v_lshlrev_b64" | "s_lshl_b64")
+                                && has_const_operand(inst, 6)
+                            {
+                                let lo = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    lo,
+                                    BvhTag::TriByteOff(0),
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriByteOff clash at B{b}:{i}");
+                                }
+                                if let Some(&(_, hi)) = inst.writes.get(1)
+                                    && !set_tag(
+                                        &mut tags,
+                                        &mut tag_facts,
+                                        &mut work,
+                                        hi,
+                                        BvhTag::AddrHi,
+                                        v_facts.clone(),
+                                    )
+                                {
+                                    meta_fail!("TriNodeShr3 hi clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_lshlrev_b32" | "s_lshl_b32")
+                                && other_const_arg(inst, v) == Some(6)
+                            {
+                                let lo = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    lo,
+                                    BvhTag::TriByteOff(0),
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriByteOff32 clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriNodeShr3 used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriSlot => {
+                            // Valid triangle leaf types are 0..=3. The status
+                            // surrogate (0 on miss, 1 on hit) satisfies the same
+                            // type test. Require the actual low-three-bit extract.
+                            if n == "v_cmpx_gt_u32"
+                                && address::plain(inst)
+                                && two_src_operands(inst).is_some_and(|(a, b)| {
+                                    const_operand(a) == Some(4) && operand_val(inst, b) == Some(v)
+                                })
+                                && self.def_inst(v).is_some_and(|(_, def)| {
+                                    address::plain(def)
+                                        && def.name() == "v_and_b32"
+                                        && def.writes.first().is_some_and(|w| w.1 == v)
+                                        && other_val_from_const_op(def, 7).is_some_and(|src| {
+                                            tags.get(&src) == Some(&BvhTag::TriNode)
+                                        })
+                                })
+                            {
+                                continue;
+                            }
+                            if n == "v_lshl_add_u32"
+                                && let Fields::Valu(f) = &inst.fields
+                                && f.src.len() >= 3
+                                && const_operand(&f.src[1]) == Some(2)
+                                && const_operand(&f.src[2]) == Some(52)
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriPrimOff,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriPrimOff clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_lshlrev_b32" | "s_lshl_b32")
+                                && other_const_arg(inst, v) == Some(2)
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriSlotShl2,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriSlotShl2 clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_min_u32" | "v_min_i32") {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriSlot,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriSlot min clash at B{b}:{i}");
+                                }
+                            } else if matches!(
+                                n,
+                                "v_cmp_lt_u32" | "v_cmp_gt_u32" | "v_cmp_eq_u32" | "v_cmp_ne_u32"
+                            ) {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriSlotCmp,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriSlotCmp clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriSlot used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriSlotShl2 => {
+                            if matches!(n, "v_add_nc_u32" | "v_add_co_u32" | "v_or_b32")
+                                && other_const_arg(inst, v) == Some(52)
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriPrimOff,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriPrimOff2 clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriSlotShl2 used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriSlotCmp => {
+                            if n == "v_cndmask_b32" {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriPrimOff,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriSlotCmp cnd clash at B{b}:{i}");
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriSlotCmp used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriPrimOff => {
+                            if n == "v_cndmask_b32" {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriPrimOff,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriPrimOff cnd clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_add_co_u32" | "v_add_nc_u32" | "v_or_b32") {
+                                let other_v = other_val_arg(inst, v)?;
+                                let out_tag = match tags.get(&other_v).copied() {
+                                    Some(BvhTag::TriByteOff(_)) => BvhTag::TriByteOffPrim,
+                                    Some(BvhTag::TriAddrLo(0)) => BvhTag::TriAddrPrimLo,
+                                    None if round < 5 => {
+                                        deferred.push((v, b, i));
+                                        continue;
+                                    }
+                                    _other => meta_fail!(
+                                        "TriPrimOff add bad other={_other:?} at B{b}:{i}@{:#x}",
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    ),
+                                };
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    out_tag,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!(
+                                        "TriPrimOff add clash at B{b}:{i}@{:#x} out={out_tag:?} prev={:?}",
+                                        self.p.blocks[b].insts[i].machine.offset,
+                                        tags.get(&w)
+                                    );
+                                }
+                                for &(wr, wv) in inst.writes.iter().skip(1) {
+                                    if matches!(wr, Reg::S(_) | Reg::Scc)
+                                        && !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            wv,
+                                            BvhTag::AddrCarry,
+                                            v_facts.clone(),
+                                        )
+                                    {
+                                        meta_fail!("TriPrimOff carry clash at B{b}:{i}");
+                                    }
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriPrimOff used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriByteOff(off) => {
+                            if matches!(n, "v_or_b32" | "s_or_b32")
+                                && let Some(k) = other_const_arg(inst, v)
+                                && k < 64
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriByteOff(off | k),
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriByteOff or clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_add_co_u32" | "v_add_nc_u32" | "v_or_b32") {
+                                let other_v = other_val_arg(inst, v)?;
+                                let out_tag = match tags.get(&other_v).copied() {
+                                    Some(BvhTag::BlasBaseLo) => BvhTag::TriAddrLo(off),
+                                    Some(BvhTag::TriPrimOff) => BvhTag::TriByteOffPrim,
+                                    None if round < 5 => {
+                                        deferred.push((v, b, i));
+                                        continue;
+                                    }
+                                    _other => meta_fail!(
+                                        "TriByteOff({off}) add bad other={_other:?} at B{b}:{i}@{:#x}",
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    ),
+                                };
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    out_tag,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!(
+                                        "TriByteOff({off}) add clash at B{b}:{i}@{:#x} out={out_tag:?} prev={:?}",
+                                        self.p.blocks[b].insts[i].machine.offset,
+                                        tags.get(&w)
+                                    );
+                                }
+                                for &(wr, wv) in inst.writes.iter().skip(1) {
+                                    if matches!(wr, Reg::S(_) | Reg::Scc)
+                                        && !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            wv,
+                                            BvhTag::AddrCarry,
+                                            v_facts.clone(),
+                                        )
+                                    {
+                                        meta_fail!("TriByteOff carry clash at B{b}:{i}");
+                                    }
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriByteOff({off}) used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriByteOffPrim => {
+                            if matches!(n, "v_add_co_u32" | "v_add_nc_u32") {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriAddrPrimLo,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!(
+                                        "TriByteOffPrim clash at B{b}:{i}@{:#x} prev={:?}",
+                                        self.p.blocks[b].insts[i].machine.offset,
+                                        tags.get(&w)
+                                    );
+                                }
+                                for &(wr, wv) in inst.writes.iter().skip(1) {
+                                    if matches!(wr, Reg::S(_) | Reg::Scc)
+                                        && !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            wv,
+                                            BvhTag::AddrCarry,
+                                            v_facts.clone(),
+                                        )
+                                    {
+                                        meta_fail!("TriByteOffPrim carry clash at B{b}:{i}");
+                                    }
+                                }
+                            } else {
+                                meta_fail!(
+                                    "TriByteOffPrim used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriAddrLo(off) => {
+                            if matches!(n, "v_or_b32" | "s_or_b32")
+                                && let Some(k) = other_const_arg(inst, v)
+                                && k < 64
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriAddrLo(off | k),
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriAddrLo or clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_add_co_u32" | "v_add_nc_u32")
+                                && let Some(k) = other_const_arg(inst, v)
+                                && k < 64
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriAddrLo(off + k),
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriAddrLo addk clash at B{b}:{i}");
+                                }
+                            } else if matches!(n, "v_add_co_u32" | "v_add_nc_u32")
+                                && other_val_arg(inst, v)
+                                    .is_some_and(|ov| tags.get(&ov) == Some(&BvhTag::TriPrimOff))
+                            {
+                                let w = inst.writes.first()?.1;
+                                if !set_tag(
+                                    &mut tags,
+                                    &mut tag_facts,
+                                    &mut work,
+                                    w,
+                                    BvhTag::TriAddrPrimLo,
+                                    v_facts.clone(),
+                                ) {
+                                    meta_fail!("TriAddrLo+Prim clash at B{b}:{i}");
+                                }
+                            } else if let Some((ndw, imm_off)) = flat_or_smem_load_info(inst, v) {
+                                let total = off.checked_add(imm_off)?;
+                                let kind = match (ndw, total) {
+                                    (1, 48) => {
+                                        let dst = inst.writes.first()?.1;
+                                        if !self.uses_only_shr_8(dst, scope) {
+                                            meta_fail!(
+                                                "GeomIdx shr8 failed at B{b}:{i}@{:#x}",
+                                                self.p.blocks[b].insts[i].machine.offset
+                                            );
+                                        }
+                                        RayMetaKind::GeometryIndexShl8
+                                    }
+                                    (1, 52) | (1, 56) => RayMetaKind::PrimitiveIndex,
+                                    _ => meta_fail!(
+                                        "TriAddrLo({total}, ndw={ndw}) unsupported load at B{b}:{i}@{:#x}",
+                                        self.p.blocks[b].insts[i].machine.offset
+                                    ),
+                                };
+                                if let Some(&prev) = loads.get(&(b, i))
+                                    && prev != kind
+                                {
+                                    meta_fail!("TriAddrLo load clash at B{b}:{i}");
+                                }
+                                loads.insert((b, i), kind);
+                            } else {
+                                meta_fail!(
+                                    "TriAddrLo({off}) used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                        BvhTag::TriAddrPrimLo => {
+                            if let Some((1, 0)) = flat_or_smem_load_info(inst, v) {
+                                let kind = RayMetaKind::PrimitiveIndex;
+                                if let Some(&prev) = loads.get(&(b, i))
+                                    && prev != kind
+                                {
+                                    meta_fail!("TriAddrPrimLo load clash at B{b}:{i}");
+                                }
+                                loads.insert((b, i), kind);
+                            } else {
+                                meta_fail!(
+                                    "TriAddrPrimLo used by {n} at B{b}:{i}@{:#x}",
+                                    self.p.blocks[b].insts[i].machine.offset
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+            if deferred.is_empty() {
+                break;
+            }
+            let retry = std::mem::take(&mut deferred);
+            let mut pushed = HashSet::new();
+            for (dv, _, _) in retry {
+                if pushed.insert(dv) {
+                    work.push(dv);
+                }
+            }
+        }
+
+        // Verify every live `AddrHi` load site ALSO had its lo word verified in `loads`!
+        for (&v, &tag) in &tags {
+            if matches!(tag, BvhTag::AddrHi) {
+                let v_facts = tag_facts.get(&v).cloned().unwrap_or_default();
+                for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                    if !scope.contains(&b) {
+                        continue;
+                    }
+                    if let Some(i) = idx_opt {
+                        let inst = &self.p.blocks[b].insts[i];
+                        if flat_or_smem_load_hi_only(inst, v) && !loads.contains_key(&(b, i)) {
+                            let mut use_check = v_facts.clone();
+                            use_check.push((self.st.reach[b], true));
+                            if let Some(g) = self.st.guards[b][i] {
+                                use_check.push((g, true));
+                            }
+                            if !self.bools_meet(&use_check) {
+                                continue;
+                            }
+                            meta_fail!(
+                                "hi-only load without lo at B{b}:{i}@{:#x} tag={tag:?}",
+                                inst.machine.offset
+                            );
+                        }
+                    }
+                }
+            }
+        }
+
+        let tlas_high = self.def_inst(tlas_base)?.1.writes.get(1)?.1;
+        if !self.metadata_addresses_proven(
+            scope,
+            loads.keys().copied(),
+            &tags,
+            tlas_high,
+            skipped_tail,
+            collapsed_exit,
+        ) {
+            return None;
+        }
+
+        let mut out: Vec<(Site, RayMetaKind)> = loads.into_iter().collect();
+        out.sort_unstable_by_key(|&(s, _)| s);
+        Some(MetaAnalysisResult { loads: out })
+    }
+
+    fn metadata_addresses_proven(
+        &self,
+        scope: &HashSet<usize>,
+        loads: impl IntoIterator<Item = Site>,
+        tags: &HashMap<Value, BvhTag>,
+        tlas_high: Value,
+        skipped_tail: Option<(usize, &HashSet<usize>)>,
+        collapsed_exit: Option<(usize, usize, &HashSet<usize>)>,
+    ) -> bool {
+        // A single hardware getter replaces the load on *every* incoming edge.
+        // Walk the actual load addresses back through tagged definitions. A PHI
+        // with another live pointer source could instead refer to a guest BVH.
+        let mut needed = Vec::new();
+        for (b, i) in loads {
+            let inst = &self.p.blocks[b].insts[i];
+            let Some(lo) = inst
+                .reads
+                .iter()
+                .map(|&(_, v)| v)
+                .find(|&v| tags.contains_key(&v) && flat_or_smem_load_info(inst, v).is_some())
+            else {
+                return false;
+            };
+            let Some(hi) = inst
+                .reads
+                .iter()
+                .map(|&(_, v)| v)
+                .find(|&v| flat_or_smem_load_hi_only(inst, v))
+            else {
+                return false;
+            };
+            if !self.proven_address_high(lo, hi, tlas_high)
+                && !self.def_inst(tlas_high).is_some_and(|(_, t)| {
+                    t.writes.get(1).map(|w| w.1) == Some(tlas_high)
+                        && self.address_pair(
+                            Word::Ssa(lo),
+                            Word::Ssa(hi),
+                            (t.writes[0].1, tlas_high),
+                            tags,
+                            0,
+                        )
+                })
+            {
+                return false;
+            }
+            needed.push((lo, Some((b, i))));
+            if tags.contains_key(&hi) {
+                needed.push((hi, Some((b, i))));
+            }
+        }
+        let mut checked = HashSet::new();
+        while let Some((v, load)) = needed.pop() {
+            if !checked.insert((v, load)) {
+                continue;
+            }
+            match self.defs[v.0 as usize] {
+                Some(Def::Phi(b, i)) if scope.contains(&b) => {
+                    let phi = &self.p.blocks[b].phis[i];
+                    for (&pred, &arg) in self.p.blocks[b].preds.iter().zip(&phi.args) {
+                        // Lowering retains exactly one incoming edge from this
+                        // traversal. Its other exit values were classified
+                        // against the canonical live-out before examining uses.
+                        if !self.native_edge(b, pred)
+                            || collapsed_exit.is_some_and(|(exit, kept, region)| {
+                                exit == b && pred != kept && region.contains(&pred)
+                            })
+                        {
+                            continue;
+                        }
+                        if tags.get(&arg) == tags.get(&v) {
+                            needed.push((arg, None));
+                        } else if self.phi_incoming_reaches_use_in_scope(
+                            arg,
+                            v,
+                            &[],
+                            scope,
+                            skipped_tail,
+                        ) {
+                            return false;
+                        }
+                    }
+                }
+                Some(Def::Inst(b, i)) if scope.contains(&b) => {
+                    let inst = &self.p.blocks[b].insts[i];
+                    // A predicated write retains the old address on some lanes and
+                    // may install an unrelated guest address on the rest. A tagged
+                    // operand alone also cannot establish both arms of a select.
+                    if self.st.guards[b][i].is_some()
+                        && !load.is_some_and(|(lb, lj)| {
+                            lb == b
+                                && i < lj
+                                && self.mask_covers(inst, &self.p.blocks[lb].insts[lj], &[])
+                        })
+                        || (matches!(
+                            inst.name(),
+                            "v_cndmask_b32" | "s_cselect_b32" | "s_cselect_b64"
+                        ) && !(tags.get(&v) == Some(&BvhTag::TriPrimOff)
+                            && self.primitive_slot_select(v, tags)))
+                    {
+                        return false;
+                    }
+                    needed.extend(inst.reads.iter().filter_map(|&(r, arg)| {
+                        (operand_reads(self.p, inst).contains(&r) && tags.contains_key(&arg))
+                            .then_some((arg, load))
+                    }));
+                }
+                _ => {}
+            }
+        }
+
+        true
+    }
+
+    /// Even a verified low dword can be paired with a different address space.
+    /// Accept the TLAS high word or an add-with-carry from the *same* low sum.
+    fn proven_address_high(&self, lo: Value, hi: Value, tlas_high: Value) -> bool {
+        let hi = self.copy_word(Word::Ssa(hi));
+        if hi == Word::Ssa(tlas_high) {
+            return true;
+        }
+        let (Word::Ssa(lo), Word::Ssa(hi)) = (self.copy_word(Word::Ssa(lo)), hi) else {
+            return false;
+        };
+        let (Some(low), Some(high)) = (self.unguarded_def(lo), self.unguarded_def(hi)) else {
+            return false;
+        };
+        self.is_wide_sum(low, high, lo, hi)
+            && other_val_from_const_op(high, 0)
+                .is_some_and(|v| self.copy_word(Word::Ssa(v)) == Word::Ssa(tlas_high))
+    }
+
+    /// A node offset added to an unrelated guest buffer can index arbitrary
+    /// application data at the very same byte offsets as an instance record.
+    fn extract_base_low_offset(&self, v: Value, tlas: Value, depth: u32) -> Option<u32> {
+        if v == tlas {
+            return Some(0);
+        }
+        if depth >= 8 {
+            return None;
+        }
+        if self.unpacked_tlas(v, tlas, None) {
+            return Some(0);
+        }
+        if let Some(Def::Phi(b, i)) = self.defs[v.0 as usize] {
+            let mut off = None;
+            for (&p, &a) in self.p.blocks[b]
+                .preds
+                .iter()
+                .zip(&self.p.blocks[b].phis[i].args)
+            {
+                if !self.native_edge(b, p) {
+                    continue;
+                }
+                let k = self.extract_base_low_offset(a, tlas, depth + 1)?;
+                if off.replace(k).is_some_and(|prev| prev != k) {
+                    return None;
+                }
+            }
+            return off;
+        }
+        let ((b, i), inst) = self.def_inst(v)?;
+        if !address::plain(inst) || inst.writes[0].1 != v {
+            return None;
+        }
+        // A masked VGPR definition leaves its previous, possibly unrelated,
+        // pointer in the inactive lanes.
+        if self.st.guards[b][i].is_some() {
+            return None;
+        }
+        if matches!(inst.name(), "s_mov_b32" | "v_mov_b32") {
+            return self.extract_base_low_offset(single_reg_src(inst)?, tlas, depth + 1);
+        }
+        let k = other_const_arg_any(inst)?;
+        let base =
+            self.extract_base_low_offset(other_val_from_const_op(inst, k)?, tlas, depth + 1)?;
+        match inst.name() {
+            "s_and_b32" | "v_and_b32" if k == 0xffff_ff00 => Some(base & k),
+            "s_or_b32" | "v_or_b32" if k < 128 => Some(base | k),
+            "s_add_u32" | "s_add_i32" | "v_add_nc_u32" | "v_add_co_u32" if k < 128 => {
+                base.checked_add(k).filter(|&n| n < 256)
+            }
+            _ => None,
+        }
+    }
+
+    /// Collects `(Bool, true)` predicates provably implied by `root != 0` for post-loop
+    /// committed node pointers (matching XDXR's `status = (node != 0) ? (1 or 2) : 0; if (status != 0 || timeout)`).
+    fn collect_hit_status_facts(
+        &self,
+        roots: &HashSet<Value>,
+        scope: &HashSet<usize>,
+        out: &mut Vec<(Bool, bool)>,
+    ) {
+        let mut nonzero_vals: HashSet<Value> = roots.clone();
+        let mut true_masks: HashSet<Value> = HashSet::new();
+        let mut work_nz: Vec<Value> = roots.iter().copied().collect();
+        let mut work_mask: Vec<Value> = Vec::new();
+
+        for _ in 0..6 {
+            while let Some(v) = work_nz.pop() {
+                for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                    if !scope.contains(&b) {
+                        continue;
+                    }
+                    let Some(i) = idx_opt else {
+                        // Step through a merge PHI (e.g. `exit_block` joining loop hit with bypass)
+                        // so `v_cmp_ne_u32 _, 0, phi_tri_node` is recognised!
+                        for phi in &self.p.blocks[b].phis {
+                            if phi.args.contains(&v) && nonzero_vals.insert(phi.value) {
+                                work_nz.push(phi.value);
+                            }
+                        }
+                        continue;
+                    };
+                    let inst = &self.p.blocks[b].insts[i];
+                    if matches!(inst.name(), "v_mov_b32" | "s_mov_b32")
+                        && single_reg_src(inst) == Some(v)
+                        && let Some(&(_, w)) = inst.writes.first()
+                        && nonzero_vals.insert(w)
+                    {
+                        work_nz.push(w);
+                        continue;
+                    }
+                    if matches!(
+                        inst.name(),
+                        "v_cmp_ne_u32" | "v_cmp_ne_i32" | "v_cmpx_ne_u32"
+                    ) && other_const_arg(inst, v) == Some(0)
+                        && let Some(&(_, mw)) = inst.writes.first()
+                        && let Some(&mb) = self.st.masks.get(&mw)
+                        && true_masks.insert(mw)
+                    {
+                        if mb != Bool::TRUE && !out.contains(&(mb, true)) {
+                            out.push((mb, true));
+                        }
+                        work_mask.push(mw);
+                    }
+                }
+            }
+            while let Some(mv) = work_mask.pop() {
+                for &(b, idx_opt) in &self.uses[mv.0 as usize] {
+                    if !scope.contains(&b) {
+                        continue;
+                    }
+                    let Some(i) = idx_opt else { continue };
+                    let inst = &self.p.blocks[b].insts[i];
+                    match inst.name() {
+                        "s_or_b32" | "s_or_b64" => {
+                            if let Some(&(_, w)) = inst.writes.first()
+                                && let Some(&mb) = self.st.masks.get(&w)
+                                && true_masks.insert(w)
+                            {
+                                if mb != Bool::TRUE && !out.contains(&(mb, true)) {
+                                    out.push((mb, true));
+                                }
+                                work_mask.push(w);
+                            }
+                        }
+                        "s_and_b32" | "s_and_b64" => {
+                            // `s_and(tri_node != 0, inst_node != 0)` is true whenever a hit occurred!
+                            if let Some((lhs, rhs)) = two_src_operands(inst)
+                                && operand_val(inst, lhs).is_some_and(|a| true_masks.contains(&a))
+                                && operand_val(inst, rhs).is_some_and(|b| true_masks.contains(&b))
+                                && let Some(&(_, w)) = inst.writes.first()
+                                && let Some(&mb) = self.st.masks.get(&w)
+                                && true_masks.insert(w)
+                            {
+                                if mb != Bool::TRUE && !out.contains(&(mb, true)) {
+                                    out.push((mb, true));
+                                }
+                                work_mask.push(w);
+                            }
+                        }
+                        "v_cndmask_b32" => {
+                            if let Fields::Valu(f) = &inst.fields
+                                && f.src.len() >= 3
+                                && operand_val(inst, &f.src[2]) == Some(mv)
+                                && const_operand(&f.src[0]) == Some(0)
+                                && self.is_definitely_nonzero_operand(inst, &f.src[1])
+                                && let Some(&(_, w)) = inst.writes.first()
+                                && nonzero_vals.insert(w)
+                            {
+                                work_nz.push(w);
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            if work_nz.is_empty() && work_mask.is_empty() {
+                break;
+            }
+        }
+    }
+
+    fn is_definitely_nonzero_operand(&self, inst: &Inst, op: &Operand) -> bool {
+        if let Some(k) = const_operand(op) {
+            return k != 0;
+        }
+        let Some(v) = operand_val(inst, op) else {
+            return false;
+        };
+        let Some((_, di)) = self.def_inst(v) else {
+            return false;
+        };
+        if di.name() == "v_cndmask_b32"
+            && let Fields::Valu(f) = &di.fields
+            && f.src.len() >= 2
+        {
+            return const_operand(&f.src[0]).is_some_and(|k| k != 0)
+                && const_operand(&f.src[1]).is_some_and(|k| k != 0);
+        }
+        false
+    }
+
+    /// Returns `true` if `incoming_v` (defined in `def_b`) can actually reach a real operand
+    /// read of `phi_val` inside `scope` (checking lane disjointness via `st.bools.meet`,
+    /// tracking `phi_masks`, negated write guards, and waterfall-loop kills).
+    fn phi_incoming_reaches_use_in_scope(
+        &self,
+        incoming_v: Value,
+        phi_val: Value,
+        extra_facts: &[(Bool, bool)],
+        scope: &HashSet<usize>,
+        skipped_tail: Option<(usize, &HashSet<usize>)>,
+    ) -> bool {
+        let def_reach = self
+            .def_block(incoming_v)
+            .map(|db| self.st.reach[db])
+            .unwrap_or(Bool::TRUE);
+        let mut init_facts: Vec<(Bool, bool)> = extra_facts.to_vec();
+        if def_reach != Bool::TRUE && !init_facts.contains(&(def_reach, true)) {
+            init_facts.push((def_reach, true));
+        }
+        if let Some(Def::Phi(pb, pi)) = self.defs.get(phi_val.0 as usize).copied().flatten() {
+            let phi = &self.p.blocks[pb].phis[pi];
+            let mut any_reaches = false;
+            if let Some(margs) = self.st.phi_masks.get(&phi_val) {
+                for (&arg, &mb) in phi.args.iter().zip(margs) {
+                    if arg != incoming_v {
+                        continue;
+                    }
+                    let mut f = init_facts.clone();
+                    if mb != Bool::TRUE && !f.contains(&(mb, true)) {
+                        f.push((mb, true));
+                    }
+                    if self.bools_meet(&f)
+                        && self.value_reaches_op_use_under(phi_val, f, scope, skipped_tail)
+                    {
+                        any_reaches = true;
+                        break;
+                    }
+                }
+            } else {
+                for (&pred, &arg) in self.p.blocks[pb].preds.iter().zip(&phi.args) {
+                    if arg != incoming_v {
+                        continue;
+                    }
+                    let f = self.edge_facts(pred, pb, &init_facts);
+                    if self.bools_meet(&f)
+                        && self.value_reaches_op_use_under(phi_val, f, scope, skipped_tail)
+                    {
+                        any_reaches = true;
+                        break;
+                    }
+                }
+            }
+            return any_reaches;
+        }
+        self.value_reaches_op_use_under(phi_val, init_facts, scope, skipped_tail)
+    }
+
+    fn value_reaches_op_use_under(
+        &self,
+        root: Value,
+        init_facts: Vec<(Bool, bool)>,
+        scope: &HashSet<usize>,
+        skipped_tail: Option<(usize, &HashSet<usize>)>,
+    ) -> bool {
+        if !self.bools_meet(&init_facts) {
+            return false;
+        }
+        let mut seen: HashSet<(Value, Vec<(Bool, bool)>)> = HashSet::new();
+        let mut work: Vec<(Value, Vec<(Bool, bool)>)> = vec![(root, init_facts)];
+        let mut steps = 0usize;
+        while let Some((v, facts)) = work.pop() {
+            steps += 1;
+            if steps > 256 {
+                return true; // Conservative fail-safe on huge graphs.
+            }
+            if !seen.insert((v, facts.clone())) {
+                continue;
+            }
+            for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                if !scope.contains(&b) {
+                    continue;
+                }
+                let Some(i) = idx_opt else {
+                    for phi in &self.p.blocks[b].phis {
+                        if !phi.args.contains(&v) {
+                            continue;
+                        }
+                        if let Some(margs) = self.st.phi_masks.get(&phi.value) {
+                            for (&arg, &mb) in phi.args.iter().zip(margs) {
+                                if arg != v {
+                                    continue;
+                                }
+                                let mut nf = facts.clone();
+                                if mb != Bool::TRUE && !nf.contains(&(mb, true)) {
+                                    nf.push((mb, true));
+                                }
+                                if self.bools_meet(&nf) {
+                                    work.push((phi.value, nf));
+                                }
+                            }
+                        } else {
+                            for (&pred, &arg) in self.p.blocks[b].preds.iter().zip(&phi.args) {
+                                if arg != v {
+                                    continue;
+                                }
+                                let nf = self.edge_facts(pred, b, &facts);
+                                if self.bools_meet(&nf) {
+                                    work.push((phi.value, nf));
+                                }
+                            }
+                        }
+                    }
+                    continue;
+                };
+                if let Some((tb, sk)) = skipped_tail
+                    && b == tb
+                    && sk.contains(&i)
+                {
+                    continue;
+                }
+                let inst = &self.p.blocks[b].insts[i];
+                let ops = operand_reads(self.p, inst);
+                if inst
+                    .reads
+                    .iter()
+                    .any(|&(r, rv)| rv == v && ops.contains(&r))
+                {
+                    let mut check = facts.clone();
+                    check.push((self.st.reach[b], true));
+                    if let Some(g) = self.st.guards[b][i] {
+                        check.push((g, true));
+                    } else if inst.name().starts_with("v_cmp_") {
+                        // `v_cmp_*` has no `st.guards[b][i]` in `structure.rs`, even when it sits
+                        // inside an `s_and_saveexec` / `v_cmpx` sub-scope of block `b`. Find any
+                        // guarded VALU instruction in the exact same EXEC sub-scope of `b` to
+                        // recover `exec_at_inst`!
+                        if let Some(eg) = self.same_exec_scope_guard(b, i) {
+                            check.push((eg, true));
+                        }
+                    }
+                    if self.bools_meet(&check) {
+                        return true;
+                    }
+                    continue;
+                }
+                if let Some(g) = self.st.guards[b][i] {
+                    let kill_cond = if self.is_waterfall_kill_block(b, v) {
+                        self.st.reach[b]
+                    } else {
+                        g
+                    };
+                    let mut nf = facts.clone();
+                    if !nf.contains(&(kill_cond, false)) {
+                        nf.push((kill_cond, false));
+                    }
+                    if self.bools_meet(&nf) {
+                        for &(r, rv) in &inst.reads {
+                            if rv == v
+                                && let Some(w) = inst.write(r)
+                            {
+                                work.push((w, nf.clone()));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        false
+    }
+
+    /// Returns the guard `Bool` of the EXEC sub-scope containing `(b, i)`, found by scanning
+    /// neighbor instructions in `b` without crossing any instruction that writes `EXEC`.
+    fn same_exec_scope_guard(&self, b: usize, i: usize) -> Option<Bool> {
+        let insts = &self.p.blocks[b].insts;
+        let writes_exec = |inst: &Inst| {
+            inst.writes
+                .iter()
+                .any(|&(r, _)| matches!(r, Reg::S(c) if c == EXEC || c == EXEC + 1))
+        };
+        for j in (0..i).rev() {
+            if writes_exec(&insts[j]) {
+                break;
+            }
+            if let Some(g) = self.st.guards[b][j] {
+                return Some(g);
+            }
+        }
+        for j in (i + 1)..insts.len() {
+            if writes_exec(&insts[j]) {
+                break;
+            }
+            if let Some(g) = self.st.guards[b][j] {
+                return Some(g);
+            }
+        }
+        None
+    }
+
+    fn reaches_global_or_smem_load(&self, root: Value, scope: &HashSet<usize>) -> bool {
+        let mut seen = HashSet::new();
+        let mut work = vec![(root, 0u32)];
+        while let Some((v, depth)) = work.pop() {
+            if depth > 16 || !seen.insert(v) {
+                continue;
+            }
+            for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                if !scope.contains(&b) {
+                    continue;
+                }
+                let Some(i) = idx_opt else {
+                    for phi in &self.p.blocks[b].phis {
+                        if phi.args.contains(&v) {
+                            work.push((phi.value, depth + 1));
+                        }
+                    }
+                    continue;
+                };
+                let inst = &self.p.blocks[b].insts[i];
+                let ops = operand_reads(self.p, inst);
+                if !inst
+                    .reads
+                    .iter()
+                    .any(|&(r, rv)| rv == v && ops.contains(&r))
+                {
+                    if self.st.guards[b][i].is_some() {
+                        for &(r, rv) in &inst.reads {
+                            if rv == v
+                                && let Some(w) = inst.write(r)
+                            {
+                                work.push((w, depth + 1));
+                            }
+                        }
+                    }
+                    continue;
+                }
+                let n = inst.name();
+                if n.starts_with("global_load_") || n.starts_with("s_load_") {
+                    return true;
+                }
+                if matches!(
+                    n,
+                    "v_mov_b32"
+                        | "s_mov_b32"
+                        | "v_or_b32"
+                        | "s_or_b32"
+                        | "v_add_co_u32"
+                        | "v_add_co_ci_u32"
+                        | "v_add_nc_u32"
+                        | "s_add_u32"
+                        | "s_addc_u32"
+                ) && let Some(&(_, w)) = inst.writes.first()
+                {
+                    work.push((w, depth + 1));
+                }
+            }
+        }
+        false
+    }
+
+    /// Verifies that every user of an `inst_addr + 48` (`InstanceID`) or `+ 52` (`InstanceContribution`)
+    /// load reads ONLY bits `23:0` (never the upper byte `InstanceMask` / `InstanceFlags`).
+    fn uses_only_low_24_bits(&self, root: Value, scope: &HashSet<usize>) -> bool {
+        let def_reach = self
+            .def_block(root)
+            .map(|db| self.st.reach[db])
+            .unwrap_or(Bool::TRUE);
+        let init_facts = if def_reach == Bool::TRUE {
+            Vec::new()
+        } else {
+            vec![(def_reach, true)]
+        };
+        let mut seen: HashSet<(Value, Vec<(Bool, bool)>)> = HashSet::new();
+        let mut work: Vec<(Value, Vec<(Bool, bool)>)> = vec![(root, init_facts)];
+        let mut steps = 0usize;
+        while let Some((v, facts)) = work.pop() {
+            steps += 1;
+            if steps > 256 {
+                return false;
+            }
+            if !seen.insert((v, facts.clone())) {
+                continue;
+            }
+            for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                if !scope.contains(&b) {
+                    continue;
+                }
+                let Some(i) = idx_opt else {
+                    for phi in &self.p.blocks[b].phis {
+                        if !phi.args.contains(&v) {
+                            continue;
+                        }
+                        for (&pred, &arg) in self.p.blocks[b].preds.iter().zip(&phi.args) {
+                            if arg != v {
+                                continue;
+                            }
+                            let nf = self.edge_facts(pred, b, &facts);
+                            if self.bools_meet(&nf) {
+                                work.push((phi.value, nf));
+                            }
+                        }
+                    }
+                    continue;
+                };
+                let inst = &self.p.blocks[b].insts[i];
+                let ops = operand_reads(self.p, inst);
+                if !inst
+                    .reads
+                    .iter()
+                    .any(|&(r, rv)| rv == v && ops.contains(&r))
+                {
+                    if let Some(g) = self.st.guards[b][i] {
+                        let kill_cond = if self.is_waterfall_kill_block(b, v) {
+                            self.st.reach[b]
+                        } else {
+                            g
+                        };
+                        let mut nf = facts.clone();
+                        if !nf.contains(&(kill_cond, false)) {
+                            nf.push((kill_cond, false));
+                        }
+                        if self.bools_meet(&nf) {
+                            for &(r, rv) in &inst.reads {
+                                if rv == v
+                                    && let Some(w) = inst.write(r)
+                                {
+                                    work.push((w, nf.clone()));
+                                }
+                            }
+                        }
+                    }
+                    continue;
+                }
+                let mut check = facts.clone();
+                check.push((self.st.reach[b], true));
+                if let Some(g) = self.st.guards[b][i] {
+                    check.push((g, true));
+                } else if inst.name().starts_with("v_cmp_")
+                    && let Some(eg) = self.same_exec_scope_guard(b, i)
+                {
+                    check.push((eg, true));
+                }
+                if !self.bools_meet(&check) {
+                    continue;
+                }
+                match inst.name() {
+                    "v_mov_b32"
+                    | "s_mov_b32"
+                    | "v_readfirstlane_b32"
+                    | "v_add_nc_u32"
+                    | "v_add_co_u32"
+                    | "s_add_u32"
+                    | "s_add_i32"
+                    | "v_sub_nc_u32"
+                    | "v_or_b32"
+                    | "s_or_b32"
+                    | "v_xor_b32"
+                    | "s_xor_b32" => {
+                        // Modular add/sub/bitwise ops depend only on bits <= k for output bits <= k,
+                        // so check that all downstream uses mask to <= 24 bits!
+                        if let Some(&(_, w)) = inst.writes.first() {
+                            work.push((w, facts.clone()));
+                        }
+                    }
+                    "v_and_b32" | "s_and_b32" => {
+                        let k = other_const_arg(inst, v).or_else(|| {
+                            other_val_arg(inst, v).and_then(|ov| self.eval_const(ov, 0))
+                        });
+                        let Some(k) = k else {
+                            return false;
+                        };
+                        if k > 0x00FF_FFFF {
+                            return false;
+                        }
+                    }
+                    "v_bfe_u32" | "v_bfe_i32" => {
+                        let Fields::Valu(f) = &inst.fields else {
+                            return false;
+                        };
+                        if f.src.len() < 3 || operand_val(inst, &f.src[0]) != Some(v) {
+                            return false;
+                        }
+                        let (Some(sh), Some(w)) =
+                            (const_operand(&f.src[1]), const_operand(&f.src[2]))
+                        else {
+                            return false;
+                        };
+                        if sh + w > 24 {
+                            return false;
+                        }
+                    }
+                    _ => return false,
+                }
+            }
+        }
+        true
+    }
+
+    /// Verifies that every user of a `tri_addr + 48` (`(GeometryIndex << 8) | flags`) load
+    /// only reads bits `31:8` (via `>> 8` or `v_bfe_u32(_, v, 8, ...)`).
+    fn uses_only_shr_8(&self, root: Value, scope: &HashSet<usize>) -> bool {
+        let def_reach = self
+            .def_block(root)
+            .map(|db| self.st.reach[db])
+            .unwrap_or(Bool::TRUE);
+        let init_facts = if def_reach == Bool::TRUE {
+            Vec::new()
+        } else {
+            vec![(def_reach, true)]
+        };
+        let mut seen: HashSet<(Value, Vec<(Bool, bool)>)> = HashSet::new();
+        let mut work: Vec<(Value, Vec<(Bool, bool)>)> = vec![(root, init_facts)];
+        let mut steps = 0usize;
+        while let Some((v, facts)) = work.pop() {
+            steps += 1;
+            if steps > 256 {
+                return false;
+            }
+            if !seen.insert((v, facts.clone())) {
+                continue;
+            }
+            for &(b, idx_opt) in &self.uses[v.0 as usize] {
+                if !scope.contains(&b) {
+                    continue;
+                }
+                let Some(i) = idx_opt else {
+                    for phi in &self.p.blocks[b].phis {
+                        if !phi.args.contains(&v) {
+                            continue;
+                        }
+                        for (&pred, &arg) in self.p.blocks[b].preds.iter().zip(&phi.args) {
+                            if arg != v {
+                                continue;
+                            }
+                            let nf = self.edge_facts(pred, b, &facts);
+                            if self.bools_meet(&nf) {
+                                work.push((phi.value, nf));
+                            }
+                        }
+                    }
+                    continue;
+                };
+                let inst = &self.p.blocks[b].insts[i];
+                let ops = operand_reads(self.p, inst);
+                if !inst
+                    .reads
+                    .iter()
+                    .any(|&(r, rv)| rv == v && ops.contains(&r))
+                {
+                    if let Some(g) = self.st.guards[b][i] {
+                        let kill_cond = if self.is_waterfall_kill_block(b, v) {
+                            self.st.reach[b]
+                        } else {
+                            g
+                        };
+                        let mut nf = facts.clone();
+                        if !nf.contains(&(kill_cond, false)) {
+                            nf.push((kill_cond, false));
+                        }
+                        if self.bools_meet(&nf) {
+                            for &(r, rv) in &inst.reads {
+                                if rv == v
+                                    && let Some(w) = inst.write(r)
+                                {
+                                    work.push((w, nf.clone()));
+                                }
+                            }
+                        }
+                    }
+                    continue;
+                }
+                let mut check = facts.clone();
+                check.push((self.st.reach[b], true));
+                if let Some(g) = self.st.guards[b][i] {
+                    check.push((g, true));
+                } else if inst.name().starts_with("v_cmp_")
+                    && let Some(eg) = self.same_exec_scope_guard(b, i)
+                {
+                    check.push((eg, true));
+                }
+                if !self.bools_meet(&check) {
+                    continue;
+                }
+                match inst.name() {
+                    "v_mov_b32" | "s_mov_b32" | "v_readfirstlane_b32" => {
+                        if let Some(&(_, w)) = inst.writes.first() {
+                            work.push((w, facts.clone()));
+                        }
+                    }
+                    "v_lshrrev_b32" | "s_lshr_b32" => {
+                        let Some(sh) = other_const_arg(inst, v) else {
+                            return false;
+                        };
+                        if sh < 8 {
+                            return false;
+                        }
+                    }
+                    "v_bfe_u32" | "v_bfe_i32" => {
+                        let Fields::Valu(f) = &inst.fields else {
+                            return false;
+                        };
+                        if f.src.len() < 3 || operand_val(inst, &f.src[0]) != Some(v) {
+                            return false;
+                        }
+                        let Some(sh) = const_operand(&f.src[1]) else {
+                            return false;
+                        };
+                        if sh < 8 {
+                            return false;
+                        }
+                    }
+                    _ => return false,
+                }
+            }
+        }
+        true
+    }
+}
