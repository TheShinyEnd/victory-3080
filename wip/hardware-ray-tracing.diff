+//! Offline ray-tracing lift corpus (`VICTORY_RT=dxr`): every compute container of
+//! `VICTORY_CORPUS` with an `image_bvh64_intersect_ray` goes through
+//! `emit::translate`; a program the lift took (DXR 1.1 bit in the shader
+//! feature flags) has its DXIL validated by the DXIL validator. TSV rows to
+//! `VICTORY_CORPUS_OUT`: file, threads, lifted/software, validated/error.
+//! `VICTORY_RT_EXPECT_LIFTED=<file>,...` names containers that must be lifted
+//! and validated (the test fails otherwise).
+//! Pattern after aleksesipenko/VIctory-RTX tests/ada_corpus.rs (GPL-3.0).
+#![cfg(windows)]
+
+use victory_shader::{
+    Container, FourCC, HwStage,
+    emit::{self, validator::Validator},
+    gfx10,
+    native_programs,
+};
+
+#[test]
+#[ignore = "harness: needs VICTORY_CORPUS and VICTORY_CORPUS_OUT and the DXIL validator"]
+fn rt_lift_corpus() {
+    let (Some(dir), Some(out)) = (std::env::var_os("VICTORY_CORPUS"), std::env::var_os("VICTORY_CORPUS_OUT")) else {
+        return;
+    };
+    // SAFETY: first thing in the process, before any translation reads it.
+    unsafe {
+        std::env::set_var("VICTORY_RT", "dxr");
+        if std::env::var_os("VICTORY_RT_LIFT").is_none() {
+            std::env::set_var("VICTORY_RT_LIFT", "all");
+        }
+    }
+    emit::set_host_max_wave(32);
+    // The live host's view-heap facts (as corpus_wave.rs): raw twins past a 2^21-slot heap whose last slot is null.
+    if std::env::var_os("VICTORY_HOST_TWINS").is_some_and(|v| v == "1") {
+        emit::set_raw_views(1 << 21);
+        emit::set_view_heap_limit((1 << 21) - 1);
+    }
+    let mut validator = Validator::load(Validator::default_path().as_deref()).unwrap();
+    let must: Vec<String> = std::env::var("VICTORY_RT_EXPECT_LIFTED")
+        .unwrap_or_default()
+        .split(',')
+        .map(|s| s.trim().to_owned())
+        .filter(|s| !s.is_empty())
+        .collect();
+    let mut files: Vec<_> = std::fs::read_dir(&dir)
+        .unwrap()
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| p.extension().is_some_and(|x| x == "dxbc"))
+        .collect();
+    files.sort();
+    let (mut rows, mut lifted, mut ray) = (Vec::new(), 0, 0);
+    let mut missing = Vec::new();
+    for path in files {
+        let name = path.file_name().unwrap().to_string_lossy().to_string();
+        let bytes = std::fs::read(&path).unwrap();
+        let Ok(c) = Container::parse(&bytes) else { continue };
+        let Some(part) = c.part(FourCC::DXIL).or(c.part(FourCC::ACCC)) else { continue };
+        let Ok(natives) = native_programs(part.data) else { continue };
+        let Some(native) = natives.into_iter().find(|n| n.stage == HwStage::Cs) else { continue };
+        let walks = gfx10::decode(&native.code)
+            .map(|v| {
+                v.iter().any(|i| {
+                    matches!(i.name(), Some("image_bvh_intersect_ray" | "image_bvh64_intersect_ray"))
+                })
+            })
+            .unwrap_or(false);
+        if !walks {
+            continue;
+        }
+        ray += 1;
+        eprintln!("FILE {name}");
+        // The live host names the program by its pipeline hash before translating (`VICTORY_TEST_LABEL`).
+        if let Ok(label) = std::env::var("VICTORY_TEST_LABEL") {
+            emit::set_program_label(&label);
+        }
+        let r = std::panic::catch_unwind(|| emit::translate(&bytes));
+        let line = match r {
+            Ok(Ok(shader)) => {
+                let c = Container::parse(&shader.dxil).unwrap();
+                let sfi = c.part(FourCC::SFI0).unwrap().data;
+                let rt = u64::from_le_bytes(sfi[..8].try_into().unwrap()) & 0x10_0000 != 0;
+                let mut dxil = shader.dxil.clone();
+                let valid = if rt { validator.validate(&mut dxil).map(|_| "valid".to_owned()) } else { Ok("-".into()) };
+                match valid {
+                    Ok(v) => {
+                        lifted += usize::from(rt);
+                        format!("{name}\t{}\t{}\t{v}", if rt { "lifted" } else { "software" }, emit::last_form())
+                    }
+                    Err(e) => format!("{name}\t{}\t{}\tINVALID {}", if rt { "lifted" } else { "software" }, emit::last_form(), e.replace('\n', " ")),
+                }
+            }
+            Ok(Err(e)) => format!("{name}\trefused\t-\t{e}"),
+            Err(_) => format!("{name}\tpanic\t-\t-"),
+        };
+        for m in &must {
+            if name.contains(m.as_str()) && !(line.contains("\tlifted\t") && line.ends_with("\tvalid")) {
+                missing.push(line.clone());
+            }
+        }
+        rows.push(line);
+    }
+    rows.push(format!("# ray programs {ray}, lifted {lifted}"));
+    std::fs::write(out, rows.iter().map(|r| r.clone() + "\n").collect::<String>()).unwrap();
+    assert!(missing.is_empty(), "{missing:?}");
+}
