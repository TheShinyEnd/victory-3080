+//! Host DXR acceleration structures for the title's ray-tracing structures (`VICTORY_RT=dxr`).
+//!
+//! The title builds its own acceleration structures through `XboxBvhBuilder.dll` (`victory-hle`'s `bvhbuilder`
+//! hooks those calls). This module is what the hook calls for the same geometry: bottom-level structures built on
+//! the card from triangles the hook decoded (`blas`; static ones are built once and compacted), top-level ones from
+//! the instance descs (`tlas`), each keyed by the title's destination address of the structure. Nothing here changes
+//! what the title sees; the structures are for shaders lifted to `RayQuery` (milestone 1: one program).
+//!
+//! The title's threads only hand over their data (`blas`, `tlas`, `alias` queue a job); one worker thread records
+//! every job it finds waiting into ONE command list on the host's queue, in the order the jobs came (a top-level
+//! structure after the bottom-level ones it names), times it, and keeps the results. The structures are new
+//! resources every time (an update excepted: same shape, same input), so a list of the title that is not submitted yet
+//! never sees one change; replaced ones live on for half a second. Memory is bounded by `VICTORY_RT_DXR_MB` (default
+//! 1536): a build that would pass it is refused and counted.
+//!
+//! Written for this tree; the design (a sidecar that follows the title's build calls) is that of aleksesipenko/VIctory-RTX
+//! (GPL-3.0, itself after maren-halv/VIctory-DXR), whose `dxr/` modules were read for the API shapes, not copied.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::mpsc::{Receiver, Sender};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+use windows::core::{IUnknown, Interface};
+
+use crate::host::host;
+
+/// Whether `VICTORY_RT=dxr`.
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_RT").is_ok_and(|v| v.eq_ignore_ascii_case("dxr")))
+}
+
+/// `VICTORY_RT_DXR_IDLE=1`: DXR is set up but nothing is built (what the setup alone costs the card's memory).
+fn idle() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_RT_DXR_IDLE").is_ok_and(|v| v == "1"))
+}
+
+fn allowance() -> u64 {
+    static MB: OnceLock<u64> = OnceLock::new();
+    *MB.get_or_init(|| std::env::var("VICTORY_RT_DXR_MB").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(1536)) << 20
+}
+
+/// One instance of a top-level structure, as the title's instance desc says it.
+#[derive(Clone, Copy, Debug)]
+pub struct Instance {
+    /// Object to world, row-major 3x4.
+    pub transform: [f32; 12],
+    pub id: u32,
+    pub mask: u8,
+    pub contribution: u32,
+    pub flags: u8,
+    /// The title's address of the bottom-level structure.
+    pub blas: u64,
+    /// Its place in the title's list of instances (diagnostics: the probe names a hit by it).
+    pub index: u32,
+}
+
+enum Job {
+    Blas { guest: u64, key: u64, vertices: Vec<f32>, fixed: bool },
+    Alias { dest: u64, source: u64 },
+    Tlas { guest: u64, instances: Vec<Instance> },
+    /// Diagnostics: closest hits of `rays` in the top-level structure of `guest`, as built by the jobs before this one.
+    Probe { guest: u64, rays: Vec<ProbeRay>, reply: std::sync::mpsc::Sender<Option<Vec<ProbeHit>>> },
+}
+
+struct Structure {
+    resource: ID3D12Resource,
+    bytes: u64,
+    /// Built with ALLOW_UPDATE (a dynamic one).
+    updatable: bool,
+    triangles: u32,
+    /// Static: asked to be compacted; the postbuild size lands in the readback buffer.
+    compact: Option<Compaction>,
+    /// A static structure (kept for good); the others are let go when no top-level structure has named them for a while.
+    fixed: bool,
+    last: Instant,
+}
+
+struct Compaction {
+    fence: u64,
+    size_read: ID3D12Resource,
+}
+
+struct Retired {
+    until: Instant,
+    fence: u64,
+    _things: Vec<IUnknown>,
+    bytes: u64,
+    /// A structure's buffer of this size class, to be reused (not released) once it is let go.
+    pool: Option<(u64, ID3D12Resource)>,
+}
+
+/// A ring of upload memory for the batches' vertex data and instance descs (one resource, not one per job).
+struct Ring {
+    buffer: ID3D12Resource,
+    at: *mut u8,
+    size: u64,
+    head: u64,
+    tail: u64,
+    /// Batches in flight: (fence, the head after them).
+    flights: Vec<(u64, u64)>,
+}
+
+// SAFETY: the mapped pointer is used only under `state`.
+unsafe impl Send for Ring {}
+
+/// The part of the ring one batch writes into.
+struct Region {
+    base: u64,
+    at: *mut u8,
+    cursor: u64,
+    end: u64,
+}
+
+impl Region {
+    /// Copies `bytes` (256-aligned) into the region; the GPU address, or None when it does not fit.
+    fn put(&mut self, bytes: &[u8]) -> Option<u64> {
+        let at = self.cursor.next_multiple_of(256);
+        let end = at.checked_add(bytes.len() as u64)?;
+        if end > self.end {
+            return None;
+        }
+        // SAFETY: inside the mapped ring, the batch's own part of it.
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.at.add(at as usize), bytes.len()) };
+        self.cursor = end;
+        Some(self.base + at)
+    }
+}
+
+/// A size class: sizes are rounded up in steps of an eighth of their power of two (and to 64 KiB), so buffers can be reused.
+fn size_class(size: u64) -> u64 {
+    let size = size.max(65536);
+    let top = 63 - size.leading_zeros();
+    let step = (1u64 << top) / 8;
+    size.next_multiple_of(step.max(65536))
+}
+
+fn missing() -> &'static Mutex<HashMap<u64, u32>> {
+    static M: OnceLock<Mutex<HashMap<u64, u32>>> = OnceLock::new();
+    M.get_or_init(Default::default)
+}
+
+/// Diagnostics: the bottom-level addresses top-level structures named that the host has no structure for, most named first
+/// (address, times named since the last call; the count is cleared), at most `n`; and how many distinct there were.
+pub fn missing_report(n: usize) -> (Vec<(u64, u32)>, usize) {
+    let mut m = missing().lock().unwrap_or_else(|e| e.into_inner());
+    let distinct = m.len();
+    let mut v: Vec<(u64, u32)> = m.drain().collect();
+    v.sort_by(|a, b| b.1.cmp(&a.1));
+    v.truncate(n);
+    (v, distinct)
+}
+
+/// A ray of the hit probe (`probe`).
+#[derive(Clone, Copy, Debug)]
+pub struct ProbeRay {
+    pub origin: [f32; 3],
+    pub tmin: f32,
+    pub direction: [f32; 3],
+    pub tmax: f32,
+}
+
+/// What the host's structure answers a probe ray: the closest triangle hit (its `InstanceID` the title's id of the instance).
+#[derive(Clone, Copy, Debug)]
+pub struct ProbeHit {
+    pub t: f32,
+    pub primitive: u32,
+    pub instance: u32,
+    /// The title's index of the instance (its place in the title's list), when known.
+    pub index: Option<u32>,
+    pub geometry: u32,
+    pub hit: bool,
+}
+
+/// Instances a persistent top-level structure holds (the title's busiest builds are far under it).
+const TLAS_CAP: u32 = 8192;
+const POOL_MOST: u64 = 64 << 20;
+const RING: u64 = 32 << 20;
+
+type Shared = Arc<Mutex<Structure>>;
+
+#[derive(Default)]
+struct State {
+    /// By the title's destination address.
+    blas: HashMap<u64, Shared>,
+    tlas: HashMap<u64, Shared>,
+    /// By the input's identity: the last dynamic structure made for it (for updates).
+    keyed: HashMap<u64, Shared>,
+    scratch: Option<(ID3D12Resource, u64)>,
+    retired: Vec<Retired>,
+    compacting: Vec<(u64, Shared)>,
+    queries: u32,
+    timing: Vec<(u64, u32)>,
+    swept: Option<Instant>,
+    /// Buffers of dynamic structures let go, by size class, for the next ones (the card kept the memory of released ones:
+    /// rt-dxrB1 made and released ~100 k buffers in 5 minutes and the card was 3 GB over what the structures held).
+    pool: HashMap<u64, Vec<ID3D12Resource>>,
+    pool_bytes: u64,
+    ring: Option<Ring>,
+    probe: Option<(ID3D12RootSignature, ID3D12PipelineState)>,
+    /// By guest top-level address: the title's index of each instance of the last build, in the host structure's order.
+    order: HashMap<u64, Vec<u32>>,
+}
+
+struct Dxr {
+    device: ID3D12Device5,
+    queue: ID3D12CommandQueue,
+    fence: ID3D12Fence,
+    next: Mutex<u64>,
+    state: Mutex<State>,
+    jobs: Mutex<Sender<Job>>,
+    heap: ID3D12QueryHeap,
+    stamps: ID3D12Resource,
+    stamps_at: *const u64,
+    frequency: u64,
+}
+
+// SAFETY: D3D12 objects are free-threaded; `stamps_at` points into a persistently mapped readback buffer read under `state`.
+unsafe impl Send for Dxr {}
+// SAFETY: as above.
+unsafe impl Sync for Dxr {}
+
+const STAMPS: u32 = 512;
+
+static STATS: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+const BUILT: usize = 0;
+const UPDATED: usize = 1;
+const STATIC: usize = 2;
+const COMPACTED: usize = 3;
+const TOP: usize = 4;
+const TRIANGLES: usize = 5;
+const REFUSED: usize = 6;
+const FAILED: usize = 7;
+const GPU_US: usize = 8;
+const COMPACT_SAVED: usize = 9;
+const INSTANCES: usize = 10;
+const INSTANCES_MISSING: usize = 11;
+const PEAK: usize = 12;
+const CPU_US: usize = 13;
+const BATCHES: usize = 14;
+const JOBS: usize = 15;
+
+fn dxr() -> Option<&'static Dxr> {
+    static DXR: OnceLock<Option<Dxr>> = OnceLock::new();
+    DXR.get_or_init(|| {
+        if !enabled() {
+            return None;
+        }
+        let host = host()?;
+        // SAFETY: plain queries and creations on the host device.
+        unsafe {
+            let mut options = D3D12_FEATURE_DATA_D3D12_OPTIONS5::default();
+            host.device
+                .CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, (&raw mut options).cast(), size_of::<D3D12_FEATURE_DATA_D3D12_OPTIONS5>() as u32)
+                .ok()?;
+            if options.RaytracingTier.0 < D3D12_RAYTRACING_TIER_1_1.0 {
+                tracing::warn!(tier = options.RaytracingTier.0, "rt dxr: the card has no DXR 1.1; VICTORY_RT=dxr does nothing");
+                return None;
+            }
+            let device: ID3D12Device5 = host.device.cast().ok()?;
+            let queue = host.queue().clone();
+            let fence: ID3D12Fence = device.CreateFence(0, D3D12_FENCE_FLAG_NONE).ok()?;
+            let mut heap: Option<ID3D12QueryHeap> = None;
+            device.CreateQueryHeap(&D3D12_QUERY_HEAP_DESC { Type: D3D12_QUERY_HEAP_TYPE_TIMESTAMP, Count: STAMPS, NodeMask: 0 }, &mut heap).ok()?;
+            let stamps = committed(&device, D3D12_HEAP_TYPE_READBACK, u64::from(STAMPS) * 8, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST)?;
+            let mut at = std::ptr::null_mut();
+            stamps.Map(0, None, Some(&mut at)).ok()?;
+            let frequency = queue.GetTimestampFrequency().unwrap_or(1_000_000_000);
+            let (tx, rx) = std::sync::mpsc::channel();
+            tracing::info!(allowance_mb = allowance() >> 20, idle = idle(), "rt dxr: host acceleration structures on (DXR 1.1)");
+            std::thread::Builder::new().name("rt-dxr".into()).spawn(move || worker(rx)).ok()?;
+            Some(Dxr { device, queue, fence, next: Mutex::new(0), state: Mutex::new(State::default()), jobs: Mutex::new(tx), heap: heap?, stamps, stamps_at: at.cast(), frequency })
+        }
+    })
+    .as_ref()
+}
+
+fn worker(rx: Receiver<Job>) {
+    loop {
+        let Ok(first) = rx.recv() else { return };
+        let mut batch = vec![first];
+        while batch.len() < 96
+            && let Ok(more) = rx.try_recv()
+        {
+            batch.push(more);
+        }
+        // `dxr()` is initialised before the first job is sent; the thread may start first.
+        let Some(d) = dxr() else {
+            std::thread::sleep(Duration::from_millis(5));
+            continue;
+        };
+        let started = Instant::now();
+        d.process(batch);
+        STATS[CPU_US].fetch_add(started.elapsed().as_micros() as u64, Relaxed);
+    }
+}
+
+/// A committed buffer.
+fn committed(device: &ID3D12Device5, kind: D3D12_HEAP_TYPE, size: u64, flags: D3D12_RESOURCE_FLAGS, state: D3D12_RESOURCE_STATES) -> Option<ID3D12Resource> {
+    let heap = D3D12_HEAP_PROPERTIES { Type: kind, ..Default::default() };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: size.max(256).next_multiple_of(256),
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        Flags: flags,
+        ..Default::default()
+    };
+    let mut out: Option<ID3D12Resource> = None;
+    // SAFETY: plain creation of a buffer.
+    unsafe { device.CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, state, None, &mut out) }.ok()?;
+    out
+}
+
+/// An upload buffer holding `bytes`.
+fn upload(device: &ID3D12Device5, bytes: &[u8]) -> Option<ID3D12Resource> {
+    let buffer = committed(device, D3D12_HEAP_TYPE_UPLOAD, bytes.len() as u64, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ)?;
+    let mut at = std::ptr::null_mut();
+    // SAFETY: a mapping of the buffer just made, written once.
+    unsafe {
+        buffer.Map(0, None, Some(&mut at)).ok()?;
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), at.cast::<u8>(), bytes.len());
+        buffer.Unmap(0, None);
+    }
+    Some(buffer)
+}
+
+fn uav_barrier(resource: &ID3D12Resource) -> D3D12_RESOURCE_BARRIER {
+    D3D12_RESOURCE_BARRIER {
+        Type: D3D12_RESOURCE_BARRIER_TYPE_UAV,
+        Flags: D3D12_RESOURCE_BARRIER_FLAG_NONE,
+        Anonymous: D3D12_RESOURCE_BARRIER_0 {
+            UAV: std::mem::ManuallyDrop::new(D3D12_RESOURCE_UAV_BARRIER { pResource: std::mem::ManuallyDrop::new(Some(resource.clone())) }),
+        },
+    }
+}
+
+fn transition(resource: &ID3D12Resource, before: D3D12_RESOURCE_STATES, after: D3D12_RESOURCE_STATES) -> D3D12_RESOURCE_BARRIER {
+    D3D12_RESOURCE_BARRIER {
+        Type: D3D12_RESOURCE_BARRIER_TYPE_TRANSITION,
+        Flags: D3D12_RESOURCE_BARRIER_FLAG_NONE,
+        Anonymous: D3D12_RESOURCE_BARRIER_0 {
+            Transition: std::mem::ManuallyDrop::new(D3D12_RESOURCE_TRANSITION_BARRIER {
+                pResource: std::mem::ManuallyDrop::new(Some(resource.clone())),
+                Subresource: D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+                StateBefore: before,
+                StateAfter: after,
+            }),
+        },
+    }
+}
+
+fn unknown(r: &ID3D12Resource) -> Option<IUnknown> {
+    r.cast::<IUnknown>().ok()
+}
+
+impl Dxr {
+    fn completed(&self) -> u64 {
+        // SAFETY: a fence of ours.
+        unsafe { self.fence.GetCompletedValue() }
+    }
+
+    /// What the structures, the scratch memory and what is being let go hold, in bytes.
+    fn measure(st: &State) -> u64 {
+        let mut seen: Vec<*const Mutex<Structure>> = Vec::new();
+        let mut total = 0;
+        for a in st.blas.values().chain(st.keyed.values()).chain(st.tlas.values()) {
+            if seen.contains(&Arc::as_ptr(a)) {
+                continue;
+            }
+            seen.push(Arc::as_ptr(a));
+            total += a.lock().unwrap_or_else(|e| e.into_inner()).bytes;
+        }
+        total + st.scratch.as_ref().map_or(0, |s| s.1) + st.retired.iter().map(|r| r.bytes).sum::<u64>() + st.pool_bytes
+    }
+
+    fn retire(&self, st: &mut State, fence: u64, things: Vec<IUnknown>, bytes: u64, delay: Duration) {
+        st.retired.push(Retired { until: Instant::now() + delay, fence, _things: things, bytes, pool: None });
+    }
+
+    /// A structure's buffer is let go: a dynamic one goes back to the pool once nothing can be reading it.
+    fn give_back(&self, st: &mut State, fence: u64, resource: ID3D12Resource, bytes: u64, pooled: bool, delay: Duration) {
+        if pooled {
+            st.retired.push(Retired { until: Instant::now() + delay, fence, _things: Vec::new(), bytes, pool: Some((bytes, resource)) });
+        } else {
+            self.retire(st, fence, unknown(&resource).into_iter().collect(), bytes, delay);
+        }
+    }
+
+    /// Lets go of what is done with (and of dynamic structures no top-level one has named for 3 s), and reads the
+    /// timestamps of the batches that finished.
+    fn tidy(&self, st: &mut State) {
+        let done = self.completed();
+        let now = Instant::now();
+        let (keep, expired): (Vec<Retired>, Vec<Retired>) = std::mem::take(&mut st.retired).into_iter().partition(|r| r.fence > done || r.until > now);
+        st.retired = keep;
+        for r in expired {
+            if let Some((class, resource)) = r.pool
+                && st.pool_bytes + class <= POOL_MOST
+            {
+                st.pool_bytes += class;
+                st.pool.entry(class).or_default().push(resource);
+            }
+        }
+        if let Some(ring) = st.ring.as_mut() {
+            let mut tail = ring.tail;
+            ring.flights.retain(|&(fence, end)| {
+                if fence <= done {
+                    tail = end;
+                    false
+                } else {
+                    true
+                }
+            });
+            ring.tail = tail;
+        }
+        if st.swept.is_none_or(|t| now.duration_since(t) > Duration::from_millis(500)) {
+            st.swept = Some(now);
+            // Dynamic structures the title no longer names are let go, but only under memory pressure: a structure the title built once
+            // (not shipped, so not `fixed`) and then names for good, in every top-level build, must stay (rt-dxrH1: tiny boxes and
+            // copies of them, named 35 000 times a minute, were swept 3 s after their one build and never came back).
+            let pressure = Self::measure(st) > allowance() / 10 * 6;
+            let stale = |a: &Shared| {
+                let s = a.lock().unwrap_or_else(|e| e.into_inner());
+                pressure && !s.fixed && now.duration_since(s.last) > Duration::from_secs(3)
+            };
+            let mut gone: Vec<Shared> = Vec::new();
+            st.blas.retain(|_, a| {
+                let old = stale(a);
+                if old {
+                    gone.push(a.clone());
+                }
+                !old
+            });
+            st.keyed.retain(|_, a| {
+                let old = stale(a);
+                if old {
+                    gone.push(a.clone());
+                }
+                !old
+            });
+            let fence = self.next.lock().map(|n| *n).unwrap_or(0);
+            let mut seen: Vec<*const Mutex<Structure>> = Vec::new();
+            for a in gone {
+                if seen.contains(&Arc::as_ptr(&a)) {
+                    continue;
+                }
+                seen.push(Arc::as_ptr(&a));
+                let (resource, bytes) = {
+                    let s = a.lock().unwrap_or_else(|e| e.into_inner());
+                    (s.resource.clone(), s.bytes)
+                };
+                // (Held in `blas` and `keyed` both: counted out once, when the last holder goes.)
+                if st.blas.values().chain(st.keyed.values()).any(|b| Arc::ptr_eq(b, &a)) {
+                    continue;
+                }
+                self.give_back(st, fence, resource, bytes, true, Duration::from_millis(500));
+            }
+        }
+        st.timing.retain(|&(fence, slot)| {
+            if fence > done {
+                return true;
+            }
+            // SAFETY: inside the mapped readback buffer; the batch has finished.
+            let (a, b) = unsafe { (*self.stamps_at.add(2 * slot as usize), *self.stamps_at.add(2 * slot as usize + 1)) };
+            if b > a {
+                STATS[GPU_US].fetch_add((b - a) * 1_000_000 / self.frequency.max(1), Relaxed);
+            }
+            false
+        });
+    }
+
+    fn scratch(&self, st: &mut State, size: u64) -> Option<ID3D12Resource> {
+        if let Some((r, have)) = &st.scratch
+            && *have >= size
+        {
+            return Some(r.clone());
+        }
+        let size = size.next_multiple_of(1 << 20).max(4 << 20);
+        let fresh = committed(&self.device, D3D12_HEAP_TYPE_DEFAULT, size, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON)?;
+        if let Some((old, bytes)) = st.scratch.replace((fresh.clone(), size)) {
+            let fence = *self.next.lock().unwrap_or_else(|e| e.into_inner()) + 1;
+            self.retire(st, fence, unknown(&old).into_iter().collect(), bytes, Duration::from_millis(100));
+        }
+        Some(fresh)
+    }
+
+    /// Records one build (or update) of `inputs` on `list`; `extras` are resources the build reads (kept until the batch finishes).
+    #[allow(clippy::too_many_arguments)]
+    fn record_build(
+        &self,
+        st: &mut State,
+        list: &ID3D12GraphicsCommandList4,
+        inputs: D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS,
+        source: Option<&ID3D12Resource>,
+        into: Option<&ID3D12Resource>,
+        compact: bool,
+        triangles: u32,
+        extras: &mut Vec<IUnknown>,
+    ) -> Option<Structure> {
+        // SAFETY: queries and creations on the host device; the inputs' pointers live through this call.
+        unsafe {
+            let mut info = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO::default();
+            self.device.GetRaytracingAccelerationStructurePrebuildInfo(&inputs, &mut info);
+            let size = size_class(info.ResultDataMaxSizeInBytes);
+            let scratch_size = if source.is_some() { info.UpdateScratchDataSizeInBytes } else { info.ScratchDataSizeInBytes };
+            if source.is_none() && into.is_none() {
+                let used = Self::measure(st);
+                if used + size + scratch_size.next_multiple_of(1 << 20) > allowance() {
+                    STATS[REFUSED].fetch_add(1, Relaxed);
+                    return None;
+                }
+                STATS[PEAK].fetch_max(used + size, Relaxed);
+            }
+            let result = match (source, into) {
+                (Some(s), _) => s.clone(),
+                (None, Some(d)) => {
+                    // A persistent top-level structure rebuilt in place: what read it before must be done.
+                    list.ResourceBarrier(&[uav_barrier(d)]);
+                    d.clone()
+                }
+                (None, None) => match st.pool.get_mut(&size).and_then(Vec::pop) {
+                    Some(r) => {
+                        st.pool_bytes = st.pool_bytes.saturating_sub(size);
+                        r
+                    }
+                    None => committed(&self.device, D3D12_HEAP_TYPE_DEFAULT, size, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE)?,
+                },
+            };
+            let scratch = self.scratch(st, scratch_size.max(info.ScratchDataSizeInBytes))?;
+            let sizes = if compact {
+                let gpu = committed(&self.device, D3D12_HEAP_TYPE_DEFAULT, 8, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS)?;
+                let read = committed(&self.device, D3D12_HEAP_TYPE_READBACK, 8, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST)?;
+                Some((gpu, read))
+            } else {
+                None
+            };
+            let desc = D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC {
+                DestAccelerationStructureData: result.GetGPUVirtualAddress(),
+                Inputs: inputs,
+                SourceAccelerationStructureData: source.map_or(0, |s| s.GetGPUVirtualAddress()),
+                ScratchAccelerationStructureData: scratch.GetGPUVirtualAddress(),
+            };
+            let post = sizes.as_ref().map(|(gpu, _)| D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC {
+                DestBuffer: gpu.GetGPUVirtualAddress(),
+                InfoType: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_COMPACTED_SIZE,
+            });
+            list.BuildRaytracingAccelerationStructure(&desc, post.as_ref().map(std::slice::from_ref));
+            list.ResourceBarrier(&[uav_barrier(&result), uav_barrier(&scratch)]);
+            let mut compaction = None;
+            if let Some((gpu, read)) = &sizes {
+                list.ResourceBarrier(&[transition(gpu, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+                list.CopyBufferRegion(read, 0, gpu, 0, 8);
+                extras.extend(unknown(gpu));
+                compaction = Some(Compaction { fence: 0, size_read: read.clone() });
+            }
+            Some(Structure {
+                resource: result,
+                bytes: if source.is_some() || into.is_some() { 0 } else { size },
+                updatable: inputs.Flags.0 & D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_ALLOW_UPDATE.0 != 0,
+                triangles,
+                compact: compaction,
+                fixed: compact,
+                last: Instant::now(),
+            })
+        }
+    }
+
+    /// The top-level structure of `guest`: one buffer for good (its address is what the title's descriptors of it
+    /// name, so it must not move), big enough for `TLAS_CAP` instances, rebuilt in place.
+    fn persistent(&self, st: &mut State, guest: u64) -> Option<ID3D12Resource> {
+        if let Some(a) = st.tlas.get(&guest) {
+            return Some(a.lock().unwrap_or_else(|e| e.into_inner()).resource.clone());
+        }
+        let inputs = D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS {
+            Type: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL,
+            Anonymous: D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS_0 { InstanceDescs: 0 },
+            Flags: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE,
+            NumDescs: TLAS_CAP,
+            DescsLayout: D3D12_ELEMENTS_LAYOUT_ARRAY,
+        };
+        let mut info = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO::default();
+        // SAFETY: a query on the host device.
+        unsafe { self.device.GetRaytracingAccelerationStructurePrebuildInfo(&inputs, &mut info) };
+        let size = size_class(info.ResultDataMaxSizeInBytes);
+        let resource = committed(&self.device, D3D12_HEAP_TYPE_DEFAULT, size, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE)?;
+        st.tlas.insert(guest, Arc::new(Mutex::new(Structure { resource: resource.clone(), bytes: size, updatable: false, triangles: 0, compact: None, fixed: true, last: Instant::now() })));
+        Some(resource)
+    }
+
+    /// The persistent top-level structure of `guest`, made (as an empty scene, built and finished) if there is none yet.
+    fn tlas_target(&self, guest: u64) -> Option<ID3D12Resource> {
+        let mut st = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(a) = st.tlas.get(&guest) {
+            return Some(a.lock().unwrap_or_else(|e| e.into_inner()).resource.clone());
+        }
+        let resource = self.persistent(&mut st, guest)?;
+        // SAFETY: a fresh allocator and list of the host device, closed and submitted here, waited for below.
+        unsafe {
+            let allocator: ID3D12CommandAllocator = self.device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).ok()?;
+            let list: ID3D12GraphicsCommandList4 = self.device.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None).ok()?;
+            let inputs = D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS {
+                Type: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL,
+                Anonymous: D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS_0 { InstanceDescs: 0 },
+                Flags: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE,
+                NumDescs: 0,
+                DescsLayout: D3D12_ELEMENTS_LAYOUT_ARRAY,
+            };
+            let mut extras = Vec::new();
+            self.record_build(&mut st, &list, inputs, None, Some(&resource), false, 0, &mut extras)?;
+            list.Close().ok()?;
+            let value = {
+                let mut next = self.next.lock().unwrap_or_else(|e| e.into_inner());
+                *next += 1;
+                *next
+            };
+            self.queue.ExecuteCommandLists(&[Some(list.cast::<ID3D12CommandList>().ok()?)]);
+            self.queue.Signal(&self.fence, value).ok()?;
+            let until = Instant::now() + Duration::from_secs(2);
+            while self.completed() < value && Instant::now() < until {
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            drop(extras);
+            drop(allocator);
+        }
+        Some(resource)
+    }
+
+    /// Records the probe dispatch (one inline ray query a ray) after what the batch built; the readback buffer it fills.
+    fn record_probe(&self, st: &mut State, list: &ID3D12GraphicsCommandList4, guest: u64, rays: &[ProbeRay], extras: &mut Vec<IUnknown>) -> Option<ID3D12Resource> {
+        let tlas = st.tlas.get(&guest)?.lock().unwrap_or_else(|e| e.into_inner()).resource.clone();
+        if st.probe.is_none() {
+            st.probe = Some(self.probe_pipeline()?);
+        }
+        let (root, pso) = st.probe.clone()?;
+        let padded = rays.len().next_multiple_of(64).max(64);
+        let mut raw = vec![0u8; padded * 32];
+        for (k, r) in rays.iter().enumerate() {
+            let w = [r.origin[0], r.origin[1], r.origin[2], r.tmin, r.direction[0], r.direction[1], r.direction[2], r.tmax];
+            for (j, v) in w.iter().enumerate() {
+                raw[k * 32 + j * 4..k * 32 + j * 4 + 4].copy_from_slice(&v.to_le_bytes());
+            }
+        }
+        let rays_buffer = upload(&self.device, &raw)?;
+        let hits = committed(&self.device, D3D12_HEAP_TYPE_DEFAULT, padded as u64 * 24, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS)?;
+        let read = committed(&self.device, D3D12_HEAP_TYPE_READBACK, padded as u64 * 24, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST)?;
+        // SAFETY: recording on the batch's list; the resources are kept until the batch finishes.
+        unsafe {
+            list.ResourceBarrier(&[uav_barrier(&tlas)]);
+            list.SetComputeRootSignature(&root);
+            list.SetPipelineState(&pso);
+            list.SetComputeRootShaderResourceView(0, tlas.GetGPUVirtualAddress());
+            list.SetComputeRootShaderResourceView(1, rays_buffer.GetGPUVirtualAddress());
+            list.SetComputeRootUnorderedAccessView(2, hits.GetGPUVirtualAddress());
+            list.Dispatch((padded / 64) as u32, 1, 1);
+            list.ResourceBarrier(&[uav_barrier(&hits)]);
+            list.ResourceBarrier(&[transition(&hits, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+            list.CopyBufferRegion(&read, 0, &hits, 0, padded as u64 * 24);
+        }
+        extras.extend(unknown(&rays_buffer));
+        extras.extend(unknown(&hits));
+        Some(read)
+    }
+
+    fn probe_pipeline(&self) -> Option<(ID3D12RootSignature, ID3D12PipelineState)> {
+        let param = |ty: D3D12_ROOT_PARAMETER_TYPE, register: u32| D3D12_ROOT_PARAMETER {
+            ParameterType: ty,
+            Anonymous: D3D12_ROOT_PARAMETER_0 { Descriptor: D3D12_ROOT_DESCRIPTOR { ShaderRegister: register, RegisterSpace: 0 } },
+            ShaderVisibility: D3D12_SHADER_VISIBILITY_ALL,
+        };
+        let params = [param(D3D12_ROOT_PARAMETER_TYPE_SRV, 0), param(D3D12_ROOT_PARAMETER_TYPE_SRV, 1), param(D3D12_ROOT_PARAMETER_TYPE_UAV, 0)];
+        let desc = D3D12_ROOT_SIGNATURE_DESC { NumParameters: 3, pParameters: params.as_ptr(), NumStaticSamplers: 0, pStaticSamplers: std::ptr::null(), Flags: D3D12_ROOT_SIGNATURE_FLAG_NONE };
+        // SAFETY: serialising and creating on the host device; the blob outlives the call.
+        unsafe {
+            let mut blob = None;
+            let mut error = None;
+            D3D12SerializeRootSignature(&desc, D3D_ROOT_SIGNATURE_VERSION_1, &mut blob, Some(&mut error)).ok()?;
+            let blob = blob?;
+            let root: ID3D12RootSignature = self.device.CreateRootSignature(0, std::slice::from_raw_parts(blob.GetBufferPointer().cast::<u8>(), blob.GetBufferSize())).ok()?;
+            static CODE: &[u8] = include_bytes!("dxr_probe.dxil");
+            let pso_desc = D3D12_COMPUTE_PIPELINE_STATE_DESC {
+                pRootSignature: std::mem::ManuallyDrop::new(Some(root.clone())),
+                CS: D3D12_SHADER_BYTECODE { pShaderBytecode: CODE.as_ptr().cast(), BytecodeLength: CODE.len() },
+                ..Default::default()
+            };
+            let pso: ID3D12PipelineState = match self.device.CreateComputePipelineState(&pso_desc) {
+                Ok(p) => p,
+                Err(e) => {
+                    tracing::warn!(?e, "rt dxr: the hit probe's pipeline was refused");
+                    return None;
+                }
+            };
+            Some((root, pso))
+        }
+    }
+
+    fn process(&self, jobs: Vec<Job>) {
+        let mut st = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        self.tidy(&mut st);
+        self.compact_ready(&mut st);
+        STATS[BATCHES].fetch_add(1, Relaxed);
+        STATS[JOBS].fetch_add(jobs.len() as u64, Relaxed);
+        if idle() {
+            return;
+        }
+        // SAFETY: a fresh allocator and list of the host device, closed and submitted below.
+        let recorded = unsafe {
+            let Some(allocator): Option<ID3D12CommandAllocator> = self.device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).ok() else { return };
+            let Some(list): Option<ID3D12GraphicsCommandList4> = self.device.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None).ok() else { return };
+            let slot = st.queries % (STAMPS / 2);
+            st.queries += 1;
+            list.EndQuery(&self.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * slot);
+            let mut extras: Vec<IUnknown> = Vec::new();
+            let mut pending_compaction: Vec<Shared> = Vec::new();
+            let mut probes: Vec<(ID3D12Resource, usize, Vec<u32>, std::sync::mpsc::Sender<Option<Vec<ProbeHit>>>)> = Vec::new();
+            let mut any = false;
+            let need: u64 = jobs
+                .iter()
+                .map(|j| match j {
+                    Job::Blas { vertices, .. } => (vertices.len() as u64 * 4).next_multiple_of(256) + 256,
+                    Job::Tlas { instances, .. } => (instances.len() as u64 * 64).next_multiple_of(256) + 256,
+                    Job::Alias { .. } | Job::Probe { .. } => 0,
+                })
+                .sum();
+            let (mut region, region_start) = self.reserve(&mut st, need);
+            for job in jobs {
+                match job {
+                    Job::Alias { dest, source } => {
+                        if let Some(s) = st.blas.get(&source).cloned() {
+                            st.blas.insert(dest, s);
+                        }
+                    }
+                    Job::Blas { guest, key, vertices, fixed } => {
+                        any |= self.record_blas(&mut st, &list, guest, key, &vertices, fixed, &mut extras, &mut pending_compaction, &mut region);
+                    }
+                    Job::Tlas { guest, instances } => {
+                        any |= self.record_tlas(&mut st, &list, guest, &instances, &mut extras, &mut region);
+                    }
+                    Job::Probe { guest, rays, reply } => match self.record_probe(&mut st, &list, guest, &rays, &mut extras) {
+                        Some(read) => {
+                            any = true;
+                            probes.push((read, rays.len(), st.order.get(&guest).cloned().unwrap_or_default(), reply));
+                        }
+                        None => {
+                            let _ = reply.send(None);
+                        }
+                    },
+                }
+            }
+            if !any {
+                if let Some(ring) = st.ring.as_mut() {
+                    ring.head = region_start;
+                }
+                return;
+            }
+            list.EndQuery(&self.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * slot + 1);
+            list.ResolveQueryData(&self.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * slot, 2, &self.stamps, u64::from(2 * slot) * 8);
+            if list.Close().is_err() {
+                return;
+            }
+            let value = {
+                let mut next = self.next.lock().unwrap_or_else(|e| e.into_inner());
+                *next += 1;
+                *next
+            };
+            let Ok(as_list) = list.cast::<ID3D12CommandList>() else { return };
+            self.queue.ExecuteCommandLists(&[Some(as_list)]);
+            if self.queue.Signal(&self.fence, value).is_err() {
+                return;
+            }
+            st.timing.push((value, slot));
+            if let (Some(ring), Some(r)) = (st.ring.as_mut(), region.as_ref()) {
+                ring.flights.push((value, r.end.min(r.cursor.next_multiple_of(256))));
+                ring.head = r.cursor.next_multiple_of(256);
+            }
+            for a in &pending_compaction {
+                if let Some(c) = a.lock().unwrap_or_else(|e| e.into_inner()).compact.as_mut() {
+                    c.fence = value;
+                }
+            }
+            st.compacting.extend(pending_compaction.into_iter().map(|a| (0, a)));
+            for (read, n, order, reply) in probes {
+                std::thread::spawn(move || {
+                    let until = Instant::now() + Duration::from_secs(10);
+                    let Some(d) = dxr() else { return };
+                    while d.completed() < value && Instant::now() < until {
+                        std::thread::sleep(Duration::from_millis(1));
+                    }
+                    let mut out = None;
+                    if d.completed() >= value {
+                        let mut at = std::ptr::null_mut();
+                        // SAFETY: the batch has finished; the readback buffer holds `n` hit records.
+                        unsafe {
+                            if read.Map(0, None, Some(&mut at)).is_ok() {
+                                let w = std::slice::from_raw_parts(at.cast::<u32>(), n * 6);
+                                out = Some(w.chunks_exact(6).map(|c| ProbeHit { t: f32::from_bits(c[0]), primitive: c[1], instance: c[2], index: order.get(c[3] as usize).copied(), geometry: c[4], hit: c[5] != 0 }).collect());
+                                read.Unmap(0, None);
+                            }
+                        }
+                    }
+                    let _ = reply.send(out);
+                });
+            }
+            extras.extend(allocator.cast::<IUnknown>().ok());
+            Some((value, extras))
+        };
+        if let Some((value, extras)) = recorded {
+            self.retire(&mut st, value, extras, 0, Duration::ZERO);
+        }
+    }
+
+    /// Takes room for `need` bytes in the upload ring (made on first use); the region, and where the ring's head was.
+    fn reserve(&self, st: &mut State, need: u64) -> (Option<Region>, u64) {
+        if st.ring.is_none() {
+            let Some(buffer) = committed(&self.device, D3D12_HEAP_TYPE_UPLOAD, RING, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ) else { return (None, 0) };
+            let mut at = std::ptr::null_mut();
+            // SAFETY: a persistent mapping of the ring just made.
+            if unsafe { buffer.Map(0, None, Some(&mut at)) }.is_err() {
+                return (None, 0);
+            }
+            st.ring = Some(Ring { buffer, at: at.cast(), size: RING, head: 0, tail: 0, flights: Vec::new() });
+        }
+        let Some(ring) = st.ring.as_mut() else { return (None, 0) };
+        let start = ring.head;
+        // Free room from the head: to the end of the ring (head at or past the tail), or up to the tail.
+        let begin = if ring.flights.is_empty() {
+            0
+        } else if ring.head >= ring.tail && ring.head + need > ring.size {
+            // Wrap, if the room before the tail is enough.
+            0
+        } else {
+            ring.head
+        };
+        let room_end = if ring.flights.is_empty() { ring.size } else if begin >= ring.tail { ring.size } else { ring.tail };
+        if begin + need > room_end || (ring.flights.is_empty() && need > ring.size) {
+            return (None, start);
+        }
+        ring.head = begin;
+        // SAFETY: the buffer is alive (held by the ring).
+        let base = unsafe { ring.buffer.GetGPUVirtualAddress() };
+        (Some(Region { base, at: ring.at, cursor: begin, end: begin + need }), start)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn record_blas(&self, st: &mut State, list: &ID3D12GraphicsCommandList4, guest: u64, key: u64, vertices: &[f32], fixed: bool, extras: &mut Vec<IUnknown>, compacting: &mut Vec<Shared>, region: &mut Option<Region>) -> bool {
+        let triangles = (vertices.len() / 9) as u32;
+        if triangles == 0 {
+            return false;
+        }
+        // SAFETY: floats as bytes.
+        let bytes: &[u8] = unsafe { std::slice::from_raw_parts(vertices.as_ptr().cast(), vertices.len() * 4) };
+        let vb_va = match region.as_mut().and_then(|r| r.put(bytes)) {
+            Some(va) => va,
+            None => {
+                let Some(vb) = upload(&self.device, bytes) else {
+                    STATS[FAILED].fetch_add(1, Relaxed);
+                    return false;
+                };
+                extras.extend(unknown(&vb));
+                // SAFETY: the buffer was just made and is kept until the batch finishes.
+                unsafe { vb.GetGPUVirtualAddress() }
+            }
+        };
+        let geometry = D3D12_RAYTRACING_GEOMETRY_DESC {
+            Type: D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES,
+            Flags: D3D12_RAYTRACING_GEOMETRY_FLAG_NONE,
+            Anonymous: D3D12_RAYTRACING_GEOMETRY_DESC_0 {
+                Triangles: D3D12_RAYTRACING_GEOMETRY_TRIANGLES_DESC {
+                    Transform3x4: 0,
+                    IndexFormat: DXGI_FORMAT_UNKNOWN,
+                    VertexFormat: DXGI_FORMAT_R32G32B32_FLOAT,
+                    IndexCount: 0,
+                    VertexCount: triangles * 3,
+                    IndexBuffer: 0,
+                    VertexBuffer: D3D12_GPU_VIRTUAL_ADDRESS_AND_STRIDE { StartAddress: vb_va, StrideInBytes: 12 },
+                },
+            },
+        };
+        let flags = if fixed {
+            D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_ALLOW_COMPACTION | D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE
+        } else {
+            D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_ALLOW_UPDATE | D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD
+        };
+        let inputs = D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS {
+            Type: D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL,
+            Flags: flags,
+            NumDescs: 1,
+            DescsLayout: D3D12_ELEMENTS_LAYOUT_ARRAY,
+            Anonymous: D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS_0 { pGeometryDescs: &geometry },
+        };
+        // An update of the last structure for this input, when the shape is the same.
+        if !fixed && let Some(prior) = st.keyed.get(&key).cloned() {
+            let (resource, ok) = {
+                let p = prior.lock().unwrap_or_else(|e| e.into_inner());
+                (p.resource.clone(), p.updatable && p.triangles == triangles)
+            };
+            if ok {
+                let inputs = D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS { Flags: flags | D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PERFORM_UPDATE, ..inputs };
+                if self.record_build(st, list, inputs, Some(&resource), None, false, triangles, extras).is_some() {
+                    prior.lock().unwrap_or_else(|e| e.into_inner()).last = Instant::now();
+                    st.blas.insert(guest, prior);
+                    STATS[UPDATED].fetch_add(1, Relaxed);
+                    return true;
+                }
+            }
+        }
+        let Some(built) = self.record_build(st, list, inputs, None, None, fixed, triangles, extras) else {
+            STATS[FAILED].fetch_add(1, Relaxed);
+            return false;
+        };
+        STATS[if fixed { STATIC } else { BUILT }].fetch_add(1, Relaxed);
+        STATS[TRIANGLES].fetch_add(u64::from(triangles), Relaxed);
+        let has_compaction = built.compact.is_some();
+        let arc: Shared = Arc::new(Mutex::new(built));
+        if has_compaction {
+            compacting.push(arc.clone());
+        }
+        let fence = *self.next.lock().unwrap_or_else(|e| e.into_inner()) + 1;
+        if !fixed {
+            // The replaced dynamic structure is kept a little (a top-level one may still name it).
+            if let Some(old) = st.keyed.insert(key, arc.clone()) {
+                let (resource, bytes) = {
+                    let o = old.lock().unwrap_or_else(|e| e.into_inner());
+                    (o.resource.clone(), o.bytes)
+                };
+                if !st.blas.values().any(|b| Arc::ptr_eq(b, &old)) {
+                    self.give_back(st, fence, resource, bytes, true, Duration::from_millis(500));
+                }
+            }
+        }
+        if let Some(old) = st.blas.insert(guest, arc) {
+            let (resource, bytes, fixed_old) = {
+                let o = old.lock().unwrap_or_else(|e| e.into_inner());
+                (o.resource.clone(), o.bytes, o.fixed)
+            };
+            if fixed_old {
+                self.retire(st, fence, unknown(&resource).into_iter().collect(), bytes, Duration::from_secs(4));
+            }
+        }
+        true
+    }
