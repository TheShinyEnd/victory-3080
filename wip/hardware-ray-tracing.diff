+#[derive(Default)]
+pub(super) struct LiftPlan {
+    loops: Vec<RayLoop>,
+    pub(super) entries: HashMap<usize, usize>,
+    pub(super) skipped: HashSet<usize>,
+    pub(super) meta: HashMap<Site, RayMetaLoad>,
+    pub(super) skip_insts: HashSet<Site>,
+    pub(super) anyhit_tails: HashMap<usize, usize>,
+    pub(super) dead_lds: bool,
+    guest_metadata_fallback: bool,
+    pub(super) dead_exit_masks: HashSet<(usize, Value)>,
+    inactive: HashMap<Value, Value>,
+    timeouts: HashMap<Site, usize>,
+    pub(super) counted_pair: bool,
+}
+
+impl LiftPlan {
+    pub(super) fn software(counted_pair: bool) -> Self {
+        Self {
+            counted_pair,
+            ..Self::default()
+        }
+    }
+
+    pub(super) fn recognize(x: &Parts, counted: bool) -> Self {
+        if x.res.bvh.is_empty() {
+            return Self::software(PAIRED.get() && counted);
+        }
+        let scalar = x.res.scalar.iter().copied().collect();
+        let loops = lift::find_ray_loops(x.p, x.st, x.res, &scalar);
+        let all = Self::admit(x, loops, counted);
+        if !all.entries.is_empty() {
+            return all;
+        }
+        let mut plan = all;
+        lift::isolated_ray_loops(x.p, x.st, x.res, &scalar, |region| {
+            let candidate = Self::admit_impl(x, region, counted, true);
+            if candidate.entries.is_empty() {
+                return false;
+            }
+            plan = candidate;
+            true
+        });
+        plan
+    }
+
+    fn admit(x: &Parts, loops: Vec<RayLoop>, counted: bool) -> Self {
+        Self::admit_impl(x, loops, counted, false)
+    }
+    fn admit_impl(x: &Parts, loops: Vec<RayLoop>, counted: bool, isolated: bool) -> Self {
+        // #854. A retained guest AnyHit CFG cannot be entered independently by
+        // both virtual lanes. A wave-wide outer branch can also bring an inactive
+        // lane to a trace. Keep the complete paired software program in these
+        // cases, before substituting metadata, LDS writes or loop tails.
+        let mut fast_edges = Vec::new();
+        for r in &loops {
+            let Some((guard, pre)) = r.shared_entry else {
+                continue;
+            };
+            let Some(edges) = guard.fast_edges(x.p, pre, r.entry_block) else {
+                return Self::software(PAIRED.get() && counted);
+            };
+            for (b, next) in edges {
+                let uniform = match x.st.exits[b] {
+                    LaneExit::Jump(s) => s == next,
+                    LaneExit::Branch { when, .. } => {
+                        x.st.bools
+                            .support(when)
+                            .iter()
+                            .all(|atom| matches!(atom, crate::structure::Atom::Uniform(_)))
+                    }
+                    _ => false,
+                };
+                if !uniform {
+                    return Self::software(PAIRED.get() && counted);
+                }
+                fast_edges.push((b, next));
+            }
+        }
+        let paired = PAIRED.get();
+        let widened = x.st.wide.iter().any(|b| {
+            !loops
+                .iter()
+                .any(|r| r.entry_block == *b || r.skipped_blocks.contains(b))
+        });
+        let mut inactive = HashMap::new();
+        if (widened && !paired)
+            || paired
+                && loops
+                    .iter()
+                    .any(|r| !paired_safe(x, r, widened, &mut inactive))
+        {
+            if !loops.is_empty() && std::env::var_os("VICTORY_WAVE_WHY").is_some() {
+                eprintln!(
+                    "Wave64: preserving software traversal and its guest EXEC/AnyHit control flow"
+                );
+            }
+            return Self::software(paired && counted);
+        }
+        // A shared guest metadata path after a software traversal must keep
+        // reading the guest BVH. A previous hardware query can still be valid.
+        let kept_inactive = isolated
+            && !paired
+            && loops.len() == 1
+            && !every_entry_lane_traces(x, &loops[0])
+            && inactive_outputs(x, &loops[0]).is_some_and(|values| {
+                inactive.extend(values);
+                true
+            });
+        let guest_fallback =
+            isolated && loops.len() == 1 && !loops[0].committed_meta_loads.is_empty();
+        if loops.iter().any(|r| {
+            r.outputs
+                .iter()
+                .any(|o| o.output == RayOutput::CompletedWatchdog)
+                && !every_entry_lane_traces(x, r)
+                && !kept_inactive
+        }) {
+            return Self::software(paired && counted);
+        }
+        if loops.iter().any(|r| {
+            !r.completed_timeouts.is_empty()
+                && !(isolated
+                    && loops.len() == 1
+                    && (every_entry_lane_traces(x, r) || kept_inactive))
+        }) {
+            return Self::software(paired && counted);
+        }
+        if guest_fallback && !isolated_metadata_safe(x, &loops[0], kept_inactive) {
+            return Self::software(PAIRED.get() && counted);
+        }
+        if !guest_fallback
+            && loops.iter().any(|rl| !rl.committed_meta_loads.is_empty())
+            && x.res.bvh.iter().any(|&((b, _), _)| {
+                !loops
+                    .iter()
+                    .any(|rl| rl.entry_block == b || rl.skipped_blocks.contains(&b))
+            })
+        {
+            if std::env::var_os("VICTORY_WAVE_WHY").is_some() {
+                eprintln!("RayQuery declined: guest and hardware traversal may share metadata");
+            }
+
+            return Self::software(PAIRED.get() && counted);
+        }
+        let single_wave = matches!(x.native.io, StageIo::Cs(cs)
+            if cs.threads.iter().product::<u32>() <= if PAIRED.get() { 64 } else { 32 });
+        // Once a whole-wave outer branch has permanently bypassed this
+        // non-reentrant version, its sibling's private traversal is disjoint.
+        if isolated
+            && single_wave
+            && !fast_edges.is_empty()
+            && let [r] = loops.as_slice()
+        {
+            let mut before = HashSet::new();
+            let mut work = vec![r.entry_block];
+            while let Some(b) = work.pop() {
+                if before.insert(b) {
+                    work.extend(&x.p.blocks[b].preds);
+                }
+            }
+            let mut after = HashSet::new();
+            let mut work = vec![r.exit_block];
+            while let Some(b) = work.pop() {
+                if after.insert(b) {
+                    work.extend(x.p.blocks[b].exit.successors());
+                }
+            }
+            for &b in &before {
+                if after.contains(&b)
+                    || r.skipped_blocks.contains(&b)
+                    || matches!(&r.kind, RayLoopKind::AnyHit(ah) if ah.body_blocks.contains(&b))
+                    || b == r.entry_block
+                    || fast_edges.iter().any(|(p, _)| *p == b)
+                {
+                    continue;
+                }
+                let LaneExit::Branch {
+                    when,
+                    taken,
+                    not_taken,
+                } = x.st.exits[b]
+                else {
+                    continue;
+                };
+                if before.contains(&taken) != before.contains(&not_taken)
+                    && x.st.bools.uniform_on(when, x.st.reach[b])
+                {
+                    fast_edges.push((
+                        b,
+                        if before.contains(&taken) {
+                            taken
+                        } else {
+                            not_taken
+                        },
+                    ));
+                }
+            }
+        }
+        let mut plan = Self::new(x.p, loops, single_wave, &fast_edges);
+        plan.counted_pair = PAIRED.get() && counted;
+        plan.guest_metadata_fallback = guest_fallback;
+        plan.inactive = inactive;
+        plan
+    }
+
+    fn new(
+        p: &Program,
+        loops: Vec<RayLoop>,
+        single_wave: bool,
+        fast_edges: &[(usize, usize)],
+    ) -> Self {
+        let mut plan = Self::default();
+        for (idx, rl) in loops.iter().enumerate() {
+            plan.entries.insert(rl.entry_block, idx);
+            plan.dead_exit_masks
+                .extend(rl.dead_exit_masks.iter().map(|&phi| (rl.exit_pred, phi)));
+            plan.timeouts
+                .extend(rl.completed_timeouts.iter().map(|&s| (s, rl.rq_group)));
+            plan.skipped.extend(&rl.skipped_blocks);
+            for &(site, kind) in &rl.committed_meta_loads {
+                plan.meta.insert(
+                    site,
+                    RayMetaLoad {
+                        loop_idx: rl.rq_group,
+                        candidate: false,
+                        kind,
+                    },
+                );
+            }
+            if let RayLoopKind::AnyHit(ah) = &rl.kind {
+                plan.anyhit_tails.insert(ah.tail_block, idx);
+                plan.skip_insts
+                    .extend(ah.skipped_tail_insts.iter().map(|i| (ah.tail_block, *i)));
+                for &(site, kind) in &ah.cand_meta_loads {
+                    plan.meta.insert(
+                        site,
+                        RayMetaLoad {
+                            loop_idx: rl.rq_group,
+                            candidate: true,
+                            kind,
+                        },
+                    );
+                }
+            }
+        }
+        match dead_bvh_lds_writes(p, &plan.entries, &plan.skipped, single_wave, fast_edges) {
+            Ok(Some(dead)) => {
+                plan.dead_lds = true;
+                plan.skip_insts.extend(dead);
+            }
+            Ok(None) => {}
+            Err(op) => {
+                if std::env::var_os("VICTORY_WAVE_WHY").is_some() {
+                    eprintln!("RayQuery declined: observable LDS operation {op}");
+                }
+                return Self::default();
+            }
+        }
+        plan.loops = loops;
+        plan
+    }
+
+    pub(super) fn report_emitted(&self, dxil: &[u8]) {
+        if self.loops.is_empty() || std::env::var_os("VICTORY_WAVE_WHY").is_none() {
+            return;
+        }
+        let mut kinds = [0; 3];
+        for region in &self.loops {
+            kinds[match region.kind {
+                RayLoopKind::OpaqueOnly => 0,
+                RayLoopKind::FrontBackTrack { .. } => 1,
+                RayLoopKind::AnyHit(_) => 2,
+            }] += 1;
+        }
+        eprintln!(
+            "RayQuery emitted opaque/front-back/AnyHit={kinds:?} dxil={}",
+            blake3::hash(dxil)
+        );
+    }
+
+    pub(super) fn removed(&self, b: usize) -> bool {
+        self.entries.contains_key(&b) || self.skipped.contains(&b)
+    }
+}
+
+/// Prove that a lane missing at entry cannot acquire guest EXEC anywhere
+/// inside this traversal. Such a lane retains its own incoming VGPR words;
+/// the query-valid bit selects the guest metadata path after reconvergence.
+fn inactive_outputs(x: &Parts, r: &RayLoop) -> Option<Vec<(Value, Value)>> {
+    if (r.template == lift::RayTemplate::Bvh32SharedTlas && r.shared_entry.is_none())
+        || x.p.wave64
+        || r.active_ray_mask.is_some()
+        || !x.st.wide.is_empty()
+    {
+        return None;
+    }
+    let p = x.p;
+    let entry = entry_value(p, r, Reg::S(EXEC))?;
+    let incoming = entry_exec(p, x.st, r)?;
+    let mut blocks = r.skipped_blocks.clone();
+    blocks.push(r.entry_block);
+    if let RayLoopKind::AnyHit(ah) = &r.kind {
+        blocks.extend(&ah.body_blocks);
+    }
+    let mut regs = HashMap::new();
+    let mut defs = HashMap::new();
+    let mut phis = HashMap::new();
+    let mut execs = Vec::new();
+    let mut lane_writes = HashSet::new();
+    for &b in &blocks {
+        for phi in &p.blocks[b].phis {
+            regs.insert(phi.value, phi.reg);
+            phis.insert(phi.value, phi.args.as_slice());
+        }
+        for i in &p.blocks[b].insts {
+            if let Some(v) = i.write(Reg::S(EXEC)) {
+                execs.push(v);
+            }
+            if i.name() == "v_writelane_b32" {
+                lane_writes.insert(i.writes.first()?.0);
+            }
+            for &(reg, v) in &i.writes {
+                regs.insert(v, reg);
+                defs.insert(v, i);
+            }
+        }
+    }
+    // Greatest fixed point for "subset of entry EXEC". Cyclic PHIs also
+    // require all external seeds to satisfy the invariant on iteration zero.
+    let mut proven: HashSet<_> = regs
+        .keys()
+        .copied()
+        .filter(|v| matches!(regs[v], Reg::S(_)))
+        .collect();
+    loop {
+        let valid = |v: Value| {
+            v == entry
+                || proven.contains(&v)
+                || !regs.contains_key(&v)
+                    && x.st
+                        .masks
+                        .get(&v)
+                        .is_some_and(|&m| !x.st.bools.meet(&[(m, true), (incoming, false)]))
+        };
+        let remove: Vec<_> = proven
+            .iter()
+            .copied()
+            .filter(|&v| {
+                if let Some(args) = phis.get(&v) {
+                    return !args.iter().copied().all(valid);
+                }
+                let Some(&i) = defs.get(&v) else {
+                    return true;
+                };
+                let src = |o: &crate::gfx10::Operand| match *o {
+                    crate::gfx10::Operand::Scalar { code, .. } => {
+                        i.read(Reg::S(code)).is_some_and(valid)
+                    }
+                    crate::gfx10::Operand::Const(128) | crate::gfx10::Operand::Literal(0) => true,
+                    _ => false,
+                };
+                let ok = match (&i.fields, i.name()) {
+                    (Fields::Sop { src: ops, .. }, "s_mov_b32" | "s_andn2_b32") => {
+                        ops.first().is_some_and(src)
+                    }
+                    (Fields::Sop { src: ops, .. }, "s_and_b32") => ops.iter().any(src),
+                    (Fields::Sop { .. }, "s_and_saveexec_b32") => {
+                        i.read(Reg::S(EXEC)).is_some_and(valid)
+                    }
+                    (Fields::Valu(_), name) if name.starts_with("v_cmp") => {
+                        i.read(Reg::S(EXEC)).is_some_and(valid)
+                    }
+                    _ => false,
+                };
+                !ok
+            })
+            .collect();
+        if remove.is_empty() {
+            if !execs.iter().all(|v| valid(*v)) {
+                return None;
+            }
+            break;
+        }
+        for v in remove {
+            proven.remove(&v);
+        }
+    }
+    let mut after = HashSet::new();
+    let mut todo = vec![r.exit_block];
+    while let Some(b) = todo.pop() {
+        if after.insert(b) {
+            todo.extend(p.blocks[b].exit.successors());
+        }
+    }
+    let cross_lane_use = |reg: Reg| {
+        after.iter().any(|&b| {
+            p.blocks[b]
+                .insts
+                .iter()
+                .any(|i| lift::reads_across_lanes(i) && i.read(reg).is_some())
+        })
+    };
+    let mut inactive = Vec::new();
+    for out in &r.outputs {
+        let reg = regs.get(&out.value)?;
+        if out.output == RayOutput::Zero && lane_writes.contains(reg) && !cross_lane_use(*reg) {
+            // The live-out proof established constant zero or absence of any
+            // observable post-loop use, including the WRITELANE destination.
+            continue;
+        }
+        if matches!(reg, Reg::V(_)) && !lane_writes.contains(reg) {
+            inactive.push((out.value, entry_value(p, r, *reg)?));
+        } else {
+            // Shared scalar words and WRITELANE results need an independent
+            // value proof. A per-lane snapshot cannot reconstruct those.
+
+            return None;
+        }
+    }
+    Some(inactive)
+}
+
+fn every_entry_lane_traces(x: &Parts, r: &RayLoop) -> bool {
+    // Untouched paths still execute the guest load. A sparse/inactive lane
+    // may retain a guest pointer in a removed region. Only specialize loads
+    // when every guest lane reaching the lifted region traces.
+    let reach = x.st.reach[r.entry_block];
+    let Some(exec) = entry_exec(x.p, x.st, r) else {
+        return false;
+    };
+    let sparse = match r.active_ray_mask {
+        Some(v) => x.st.masks.get(&v).copied(),
+        None => Some(Bool::TRUE),
+    };
+    !PAIRED.get()
+        && !x.st.bools.meet(&[(reach, true), (exec, false)])
+        && sparse.is_some_and(|mask| !x.st.bools.meet(&[(reach, true), (mask, false)]))
+}
+
+fn isolated_metadata_safe(x: &Parts, r: &RayLoop, kept_inactive: bool) -> bool {
+    if !kept_inactive && !every_entry_lane_traces(x, r) {
+        return false;
+    }
+    // An untouched traversal could have produced a new pointer between the
+    // query and a getter. Earlier and bypassed software traversals retain
+    // their real pointers and execute the original load.
+    let mut before = HashSet::new();
+    let mut todo = Vec::new();
+    for &((b, i), _) in &r.committed_meta_loads {
+        if !matches!(x.p.blocks[b].insts[i].fields, Fields::Flat { .. }) {
+            return false;
+        }
+        todo.push(b);
+    }
+    let mut after = HashSet::new();
+    let mut work = vec![r.exit_block];
+    while let Some(b) = work.pop() {
+        if after.insert(b) {
+            work.extend(x.p.blocks[b].exit.successors())
+        }
+    }
+    while let Some(b) = todo.pop() {
+        if after.contains(&b) && before.insert(b) {
+            todo.extend(&x.p.blocks[b].preds)
+        }
+    }
+    !x.res.bvh.iter().any(|&((b, _), _)| before.contains(&b))
+}
+
+fn paired_safe(
+    x: &Parts,
+    region: &RayLoop,
+    widened: bool,
+    inactive: &mut HashMap<Value, Value>,
+) -> bool {
+    if matches!(region.kind, RayLoopKind::AnyHit(_)) {
+        return false;
+    }
+    let p = x.p;
+    let h = region.entry_block;
+    let first = (region.template == lift::RayTemplate::Bvh64)
+        .then(|| {
+            p.blocks[h]
+                .insts
+                .iter()
+                .position(|i| i.name() == "image_bvh64_intersect_ray")
+        })
+        .flatten();
+    if widened && first.is_none() {
+        return false;
+    }
+    let Some(incoming) = entry_exec(p, x.st, region) else {
+        return false;
+    };
+    let mut save_inactive = widened;
+    let blocks = || std::iter::once(h).chain(region.skipped_blocks.iter().copied());
+    for b in blocks() {
+        for (j, i) in p.blocks[b].insts.iter().enumerate() {
+            if region.template == lift::RayTemplate::Bvh32SharedTlas
+                && matches!(i.name(), "s_and_b32" | "s_and_b64")
+                && i.reads
+                    .iter()
+                    .any(|(r, _)| matches!(r,Reg::S(n) if *n==EXEC||*n==EXEC+1))
+            {
+                return false;
+            }
+            let (lo, hi) = (i.write(Reg::S(EXEC)), i.write(Reg::S(EXEC + 1)));
+            if lo.is_none() && hi.is_none() {
+                continue;
+            }
+            if first.is_none_or(|pos| b == h && j < pos) {
+                return false;
+            }
+            save_inactive = true;
+            // A disabled lane must stay disabled throughout the removed CFG.
+            // CMPX and AND_SAVEEXEC only intersect the current EXEC.
+            if incoming != Bool::TRUE
+                && !i.name().starts_with("v_cmpx_")
+                && i.name() != "s_and_saveexec_b64"
+                && !lo
+                    .zip(hi)
+                    .and_then(|(l, r)| x.st.mask_bits(l, Some(r)))
+                    .is_some_and(|m| !x.st.bools.meet(&[(m, true), (incoming, false)]))
+            {
+                return false;
+            }
+        }
+    }
+    if save_inactive && incoming != Bool::TRUE {
+        // WRITELANE ignores EXEC. Scalar live-outs also need a wave-wide proof.
+        let mut registers = HashMap::new();
+        for b in blocks() {
+            for ph in &p.blocks[b].phis {
+                registers.insert(ph.value, ph.reg);
+            }
+            for i in &p.blocks[b].insts {
+                if i.name() == "v_writelane_b32" {
+                    return false;
+                }
+                registers.extend(i.writes.iter().map(|&(r, v)| (v, r)));
+            }
+        }
+        for out in &region.outputs {
+            let Some(&reg @ Reg::V(_)) = registers.get(&out.value) else {
+                return false;
+            };
+            let Some(old) = entry_value(p, region, reg) else {
+                return false;
+            };
+            inactive.insert(out.value, old);
+        }
+    }
+    true
+}
+
+/// Read a register on external edges only, before any loop backedge.
+fn entry_value(p: &Program, rl: &RayLoop, reg: Reg) -> Option<Value> {
+    let internal = |b: usize| {
+        b == rl.entry_block
+            || rl.skipped_blocks.contains(&b)
+            || matches!(&rl.kind, RayLoopKind::AnyHit(ah) if ah.body_blocks.contains(&b))
+    };
+
+    let initial = || p.inputs.iter().find(|(r, _)| *r == reg).map(|&(_, v)| v);
+    let mut value = if rl.entry_block == 0 { initial() } else { None };
+    let mut work: Vec<_> = p.blocks[rl.entry_block]
+        .preds
+        .iter()
+        .copied()
+        .filter(|&b| !internal(b))
+        .collect();
+    let mut seen = HashSet::new();
+    while let Some(b) = work.pop() {
+        if !seen.insert(b) {
+            continue;
+        }
+        let bb = &p.blocks[b];
+        let def = bb
+            .insts
+            .iter()
+            .rev()
+            .find_map(|i| i.write(reg))
+            .or_else(|| bb.phis.iter().find(|ph| ph.reg == reg).map(|ph| ph.value));
+        if let Some(v) = def.or_else(|| (b == 0).then(initial).flatten()) {
+            if value.replace(v).is_some_and(|other| other != v) {
+                return None;
+            }
+        } else {
+            work.extend(&bb.preds);
+        }
+    }
+    value
+}
+
+/// EXEC on the edges entering the guest loop, before its own back-edge masks.
+fn entry_exec(p: &Program, st: &Structured, rl: &RayLoop) -> Option<Bool> {
+    let lo = entry_value(p, rl, Reg::S(EXEC))?;
+    let hi = if p.wave64 {
+        Some(entry_value(p, rl, Reg::S(EXEC + 1))?)
+    } else {
+        None
+    };
+    st.mask_bits(lo, hi)
+}
+
+/// A query and its optional opaque pre-pass. Never shared between lo and hi.
+#[derive(Clone, Copy)]
+struct Queries {
+    rq: RayQuery,
+    opaque: Option<RayQuery>,
+    flags: u32,
+    opaque_flags: u32,
+}
+
+#[derive(Default)]
+pub(super) struct RayState {
+    groups: Vec<Vec<Queries>>,
+    pending: HashMap<usize, PendingAnyHit>,
+    pub(super) candidates: HashMap<Value, (usize, RayQuery, CandidateInput)>,
+    pub(super) cache: lift::CandidateCache,
+    // At a merge, the last trace may have been inactive or bypassed. On
+    // those paths even CommittedStatus on the uninitialized handle is invalid.
+    valid: HashMap<(usize, RayQuery), V>,
+    valid_phis: Vec<(usize, RayQuery, V)>,
+}
+
+fn is_lds_memory_inst(i: &Inst) -> bool {
+    (matches!(i.fields, Fields::Ds { .. })
+        && !(i.name().starts_with("ds_swizzle") || i.name().contains("permute")))
+        || matches!(
+            i.fields,
+            Fields::Buffer { lds: true, .. } | Fields::Flat { lds: true, .. }
+        )
+}
+
+/// An external reader may observe a removed traversal store from another lane or
+/// wave. Reject the whole candidate in that case. Read-only traversal only makes
+/// outside stores dead if no remaining instruction can observe them.
+fn dead_bvh_lds_writes(
+    p: &Program,
+    ray_entries: &HashMap<usize, usize>,
+    ray_skipped: &HashSet<usize>,
+    single_wave: bool,
+    fast_edges: &[(usize, usize)],
+) -> Result<Option<HashSet<Site>>, &'static str> {
+    if ray_entries.is_empty() {
+        return Ok(None);
+    }
+    let mut used = false;
+    let mut writes = HashSet::new();
+    let mut readers = HashMap::new();
+    let mut dead_writes = HashSet::new();
+    for (b, blk) in p.blocks.iter().enumerate() {
+        let inside = ray_entries.contains_key(&b) || ray_skipped.contains(&b);
+        for (i, inst) in blk
+            .insts
+            .iter()
+            .enumerate()
+            .filter(|(_, inst)| is_lds_memory_inst(inst))
+        {
+            if inside {
+                // Global data share and ordered/counter DS operations carry state
+                // beyond one group's local traversal stack.
+                if matches!(inst.fields, Fields::Ds { gds: true, .. })
+                    || !(inst.name().starts_with("ds_read")
+                        || inst.name().starts_with("ds_write")
+                        || inst.name() == "ds_wrxchg_rtn_b32")
+                {
+                    return Err(inst.name());
+                }
+                used = true;
+                if !inst.name().starts_with("ds_read") {
+                    writes.insert(b);
+                }
+            } else if inst.name().starts_with("ds_write")
+                && inst.writes.is_empty()
+                && !matches!(inst.fields, Fields::Ds { gds: true, .. })
+            {
+                dead_writes.insert((b, i));
+            } else {
+                readers.insert(b, inst.name());
+            }
+        }
+    }
+    if !writes.is_empty() && !readers.is_empty() {
+        // Independently scheduled waves can observe the removed stores in any
+        // order. Within one wave, a reader must finish before the store and
+        // be unreachable from it, including on the next iteration.
+        if !single_wave {
+            return Err("shared LDS across waves");
+        }
+        let order = crate::ir::reverse_postorder(&p.blocks);
+        let mut index = vec![usize::MAX; p.blocks.len()];
+        for (i, &b) in order.iter().enumerate() {
+            index[b] = i;
+        }
+        let dom = crate::ir::idoms(&p.blocks, &order, &index);
+        let mut later = HashSet::new();
+        let mut work: Vec<_> = writes.iter().copied().collect();
+        while let Some(b) = work.pop() {
+            if later.insert(b) {
+                work.extend(p.blocks[b].exit.successors());
+            }
+        }
+        // A single wave takes the scalar root/work decision together. Check
+        // the original memory ordering on that fast path; the slow path alone
+        // executes its guest copy. A reentrant dispatch cannot use this fact.
+        let mut possible = HashSet::new();
+        let successors = |b: usize| {
+            fast_edges
+                .iter()
+                .find(|(guard, _)| *guard == b)
+                .map_or_else(|| p.blocks[b].exit.successors(), |&(_, next)| vec![next])
+        };
+        if !fast_edges.is_empty() {
+            if ray_entries.len() != 1 {
+                return Err("multiple shared LDS versions");
+            }
+            let guards: HashSet<_> = fast_edges.iter().map(|&(b, _)| b).collect();
+            let mut slow_seen = HashSet::new();
+            let mut slow_work: Vec<_> = fast_edges
+                .iter()
+                .filter_map(|&(b, chosen)| match p.blocks[b].exit {
+                    Exit::Branch { taken, not_taken } => {
+                        Some(if taken == chosen { not_taken } else { taken })
+                    }
+                    _ => None,
+                })
+                .collect();
+            while let Some(b) = slow_work.pop() {
+                if slow_seen.insert(b) {
+                    slow_work.extend(p.blocks[b].exit.successors());
+                }
+            }
+            if !guards.is_disjoint(&later) || !guards.is_disjoint(&slow_seen) {
+                return Err("reentrant shared LDS version");
+            }
+            let mut work = vec![0];
+            while let Some(b) = work.pop() {
+                if possible.insert(b) {
+                    work.extend(successors(b));
+                }
+            }
+        }
+        for (&reader, &op) in &readers {
+            if !fast_edges.is_empty() && !possible.contains(&reader) {
+                continue;
+            }
+
+            if later.contains(&reader)
+                || !PAIRED.get()
+                    && writes.iter().any(|&b| {
+                        let mut joins = HashSet::new();
+                        let mut at = b;
+                        loop {
+                            joins.insert(at);
+                            if at == 0 {
+                                break;
+                            }
+                            if dom[at] == usize::MAX || dom[at] == at {
+                                return true;
+                            }
+                            at = dom[at];
+                        }
+                        // An optional earlier reader can rejoin the wave before a
+                        // later traversal. Every continuation of this reader must
+                        // pass a dominator of the store (including the reader itself).
+                        let mut seen = HashSet::new();
+                        let mut work = vec![reader];
+                        while let Some(at) = work.pop() {
+                            if joins.contains(&at) || !seen.insert(at) {
+                                continue;
+                            }
+                            let succ = successors(at);
+                            if succ.is_empty() {
+                                return true;
+                            }
+                            work.extend(succ);
+                        }
+                        false
+                    })
+            {
+                return Err(op);
+            }
+        }
+    }
+    Ok((used && readers.is_empty()).then_some(dead_writes))
+}
+
+impl Lower<'_> {
+    fn swap_lanes(&mut self) {}
+
+    pub(super) fn allocate_queries(&mut self) {
+        let loops = &self.lift.loops;
+        let Some(last) = loops.iter().map(|r| r.rq_group).max() else {
+            return;
+        };
+        for group in 0..=last {
+            let members = || loops.iter().filter(|r| r.rq_group == group);
+            let base = members()
+                .map(|r| lift::effective_const_ray_flags(r).unwrap_or(0))
+                .reduce(|a, b| a & b)
+                .expect("dense query groups");
+            let two =
+                super::super::native_rt_two_pass() && members().all(lift::is_two_pass_eligible);
+            let flags = if two {
+                base | lift::ray_flag::CULL_OPAQUE
+            } else {
+                base
+            };
+            let opaque_flags = base | lift::ray_flag::CULL_NON_OPAQUE;
+            let lanes = if false { 2 } else { 1 };
+            self.rays.groups.push(
+                (0..lanes)
+                    .map(|_| Queries {
+                        rq: RayQuery::allocate(&mut self.s, flags),
+                        opaque: two.then(|| RayQuery::allocate(&mut self.s, opaque_flags)),
+                        flags,
+                        opaque_flags,
+                    })
+                    .collect(),
+            );
+        }
+    }
+
+    pub(super) fn lift_ray_loop(&mut self, idx: usize) -> Result<(), Stop> {
+        let rl = &self.lift.loops[idx];
+        let exit = self.block[rl.exit_block].expect("lifted loop exit");
+        if false {
+            // A complete native traversal per virtual lane. The first trace
+            // flows into the second even if it misses or its EXEC bit is clear.
+            let hi = self.s.m.new_block();
+            self.lift_lane(idx, hi)?;
+            self.cur = hi;
+            self.swap_lanes();
+            let result = self.lift_lane(idx, exit);
+            self.swap_lanes();
+            self.tail[rl.exit_pred] = Some(result?);
+        } else {
+            self.tail[rl.exit_pred] = Some(self.lift_lane(idx, exit)?);
+        }
+        Ok(())
+    }
+
+    fn lift_lane(&mut self, idx: usize, exit: usize) -> Result<usize, Stop> {
+        let rl = &self.lift.loops[idx];
+        let offset = self.x.p.blocks[rl.entry_block].offset;
+        let q = self.rays.groups[rl.rq_group][0];
+        let resolve = |this: &mut Self, input: RayInput| match input {
+            RayInput::Const(k) => Ok(this.s.m.i32(k)),
+            RayInput::Val(v) | RayInput::ShiftedMask(v) => {
+                this.i32_of(v).map_err(|w| unsupported(offset, w))
+            }
+        };
+        let tlas_src = Source::Loaded {
+            load: rl.tlas_load,
+            first: 0,
+        };
+        let tlas = self
+            .handle(rl.tlas_load, &tlas_src, false, (16, 0))
+            .map_err(|w| unsupported(offset, w))?;
+        let incoming = entry_exec(self.x.p, self.x.st, rl)
+            .ok_or_else(|| unsupported(offset, "unresolved RayQuery entry EXEC"))?;
+        let sparse = rl
+            .active_ray_mask
+            .map(|value| {
+                self.x
+                    .st
+                    .masks
+                    .get(&value)
+                    .copied()
+                    .ok_or_else(|| unsupported(offset, "unresolved active RayQuery lane mask"))
+            })
+            .transpose()?;
+        let mut active_ray = None::<V>;
+        for mask in [Some(incoming), sparse].into_iter().flatten() {
+            if mask != Bool::TRUE {
+                let lane = self
+                    .boolean(mask, self.cur)
+                    .map_err(|w| unsupported(offset, w))?;
+                active_ray = Some(match active_ray {
+                    Some(previous) => self.s.m.bin(self.cur, Bin::And, previous, lane),
+                    None => lane,
+                });
+            }
+        }
+        let origin = [
+            resolve(self, rl.origin[0])?,
+            resolve(self, rl.origin[1])?,
+            resolve(self, rl.origin[2])?,
+        ];
+        let t_min = rl.t_min.map(|i| resolve(self, i)).transpose()?;
+        let dir = [
+            resolve(self, rl.dir[0])?,
+            resolve(self, rl.dir[1])?,
+            resolve(self, rl.dir[2])?,
+        ];
+        let t_max = resolve(self, rl.t_max)?;
+        let mut dynamic = |input| match input {
+            RayInput::Const(_) => Ok(None),
+            other => resolve(self, other).map(Some),
+        };
+        let instance_mask = dynamic(rl.instance_mask)?;
+        let ray_flags = dynamic(rl.ray_flags)?;
+        let init_min_front_t = match rl.kind {
+            RayLoopKind::FrontBackTrack { init_min_front_t } => {
+                Some(resolve(self, init_min_front_t)?)
+            }
+            _ => None,
+        };
+        let mut anyhit_inits = Vec::new();
+        let mut anyhit_entry_dxil = None;
+        let mut fallbacks = HashMap::new();
+        if let RayLoopKind::AnyHit(ah) = &rl.kind {
+            for sv in &ah.state_vars {
+                anyhit_inits.push(resolve(self, sv.init)?);
+            }
+            anyhit_entry_dxil = Some(self.block[ah.entry_block].expect("anyhit entry"));
+            for &(_, ci) in &ah.inputs {
+                if let CandidateInput::CopyOf(pre) = ci {
+                    fallbacks.insert(pre, self.i32_of(pre).map_err(|w| unsupported(offset, w))?);
+                }
+            }
+        }
+        for out in &rl.outputs {
+            let copy = match out.output {
+                RayOutput::CopyOf(pre) => Some(pre),
+                _ => None,
+            };
+            for v in out.fallback.into_iter().chain(copy) {
+                if let std::collections::hash_map::Entry::Vacant(entry) = fallbacks.entry(v) {
+                    entry.insert(self.i32_of(v).map_err(|w| unsupported(offset, w))?);
+                }
+            }
+        }
+        let mut inactive = HashMap::new();
+        for out in &rl.outputs {
+            if let Some(&old) = self.lift.inactive.get(&out.value) {
+                inactive.insert(
+                    out.value,
+                    self.i32_of(old).map_err(|w| unsupported(offset, w))?,
+                );
+            }
+        }
+        let inputs = ResolvedRayInputs {
+            inactive,
+            rq: q.rq,
+            rq_opaque: q.opaque,
+            tlas,
+            active_ray,
+            origin,
+            t_min,
+            dir,
+            t_max,
+            instance_mask,
+            ray_flags,
+            group_const_flags: q.flags,
+            group_opaque_const_flags: q.opaque_flags,
+            init_min_front_t,
+            anyhit_inits,
+            anyhit_entry_dxil,
+            fallbacks,
+        };
+
+        let emitted = lift::emit_ray_loop(&mut self.s, self.cur, exit, rl, &inputs);
+        for (val, dxil_v) in emitted.outs {
+            self.vals.insert(val, Val::I32(dxil_v));
+        }
+        if let RayLoopKind::AnyHit(ah) = &rl.kind
+            && let Some(pending) = emitted.pending_anyhit
+        {
+            let rq = q.rq;
+            for &(val_id, ci) in &ah.inputs {
+                if matches!(
+                    ci,
+                    CandidateInput::RayT | CandidateInput::Bary(_) | CandidateInput::FrontFace
+                ) {
+                    self.rays
+                        .candidates
+                        .insert(val_id, (pending.anyhit_bridge_blk, rq, ci));
+                }
+            }
+            for &(atom_v, const_b) in &ah.const_lane_atoms {
+                let bv = self.s.m.bool(const_b);
+                self.lane_bits.insert(atom_v, bv);
+            }
+            self.tail[ah.opacity_block] = Some(pending.anyhit_bridge_blk);
+            self.rays.pending.insert(idx, pending);
+        }
+        let ran = active_ray.unwrap_or_else(|| self.s.m.bool(true));
+        self.rays.valid.insert((emitted.tail, q.rq), ran);
+        Ok(emitted.tail)
+    }
+
+    pub(super) fn finish_anyhit(&mut self, idx: usize) -> Result<(), Stop> {
+        let RayLoopKind::AnyHit(ah) = &self.lift.loops[idx].kind else {
+            unreachable!()
+        };
+        let offset = self.x.p.blocks[ah.tail_block].offset;
+        let pending = self.rays.pending.remove(&idx).expect("pending AnyHit");
+        let mut accept = match self.x.st.masks.get(&ah.accept_mask).copied() {
+            Some(bm) => self
+                .boolean(bm, self.cur)
+                .map_err(|w| unsupported(offset, w))?,
+            None => self
+                .lane_bits
+                .get(&ah.accept_mask)
+                .copied()
+                .ok_or_else(|| unsupported(offset, "any-hit accept mask"))?,
+        };
+        if ah.accept_invert {
+            let t = self.s.m.bool(true);
+            accept = self.s.m.bin(self.cur, Bin::Xor, accept, t);
+        }
+        let mut next_vals = Vec::with_capacity(ah.state_vars.len());
+        for sv in &ah.state_vars {
+            next_vals.push(self.i32_of(sv.next).map_err(|w| unsupported(offset, w))?);
+        }
+        let tail_blk = self.cur;
+        self.s.m.terminate(
+            tail_blk,
+            Term::CondBr(accept, pending.do_commit_blk, pending.latch_blk),
+        );
+        for k in 0..ah.state_vars.len() {
+            let back_val = if let Some(cb) = pending.cand_check_blk {
+                self.s.m.set_phi(
+                    pending.latch_phis[k],
+                    vec![
+                        (pending.state_phis[k], cb),
+                        (next_vals[k], tail_blk),
+                        (next_vals[k], pending.do_commit_blk),
+                    ],
+                );
+                pending.latch_phis[k]
+            } else {
+                next_vals[k]
+            };
+            self.s.m.set_phi(
+                pending.state_phis[k],
+                vec![
+                    (pending.init_vals[k], pending.start_blk),
+                    (back_val, pending.latch_blk),
+                ],
+            );
+        }
+        Ok(())
+    }
+    pub(super) fn completed_timeout(&mut self, site: Site, guest: V) -> V {
+        let Some(&group) = self.lift.timeouts.get(&site) else {
+            return guest;
+        };
+        let rq = self.rays.groups[group][0].rq;
+        let traced = self.query_flag(self.cur, rq);
+        let no = self.s.m.bool(false);
+        self.s.m.select(self.cur, traced, no, guest)
+    }
+    fn query_flag(&mut self, block: usize, rq: RayQuery) -> V {
+        if block == 0 {
+            return self.s.m.bool(false);
+        }
+        *self.rays.valid.entry((block, rq)).or_insert_with(|| {
+            let phi = self.s.m.phi(block, self.s.t.i1);
+            self.rays.valid_phis.push((block, rq, phi));
+            phi
+        })
+    }
+
+    pub(super) fn finish_query_validity(&mut self) {
+        if self.rays.valid_phis.is_empty() {
+            return;
+        }
+        let preds = self.s.m.predecessors();
+        while let Some((b, rq, phi)) = self.rays.valid_phis.pop() {
+            let incoming = preds[b]
+                .iter()
+                .map(|&p| (self.query_flag(p, rq), p))
+                .collect();
+            self.s.m.set_phi(phi, incoming);
+        }
+    }
+
+    pub(super) fn ray_metadata(
+        &mut self,
+        b: usize,
+        i: usize,
+        meta: RayMetaLoad,
+    ) -> Result<(), Stop> {
+        if meta.candidate || !self.lift.guest_metadata_fallback {
+            return self.native_metadata(b, i, meta);
+        }
+        let inst = &self.x.p.blocks[b].insts[i];
+        let q = self.rays.groups[meta.loop_idx][0];
+        let traced = self.query_flag(self.cur, q.rq);
+        let (guest, native, done) = (
+            self.s.m.new_block(),
+            self.s.m.new_block(),
+            self.s.m.new_block(),
+        );
+        self.s
+            .m
+            .terminate(self.cur, Term::CondBr(traced, native, guest));
+        self.cur = guest;
+        self.flat(inst, b, i)
+            .map_err(|w| unsupported(inst.machine.offset, w))?;
+        let words = |l: &mut Self| {
+            inst.writes
+                .iter()
+                .map(|&(_, v)| l.i32_of(v).map_err(|w| unsupported(inst.machine.offset, w)))
+                .collect::<Result<Vec<_>, _>>()
+        };
+        let guest_words = words(self)?;
+        let from_guest = self.cur;
+        self.s.m.terminate(from_guest, Term::Br(done));
+        self.cur = native;
+        self.native_metadata(b, i, meta)?;
+        let native_words = words(self)?;
+        let from_native = self.cur;
+        self.s.m.terminate(from_native, Term::Br(done));
+        self.cur = done;
+        for ((&(_, v), g), n) in inst.writes.iter().zip(guest_words).zip(native_words) {
+            let phi = self.s.m.phi(done, self.s.t.i32);
+            self.s
+                .m
+                .set_phi(phi, vec![(g, from_guest), (n, from_native)]);
+            self.vals.insert(v, Val::I32(phi));
+        }
+        Ok(())
+    }
+    fn native_metadata(&mut self, b: usize, i: usize, meta: RayMetaLoad) -> Result<(), Stop> {
+        let inst = &self.x.p.blocks[b].insts[i];
+        let guard = self
+            .guard(b, i)
+            .map_err(|w| unsupported(inst.machine.offset, w))?;
+        let q = self.rays.groups[meta.loop_idx][0];
+        let n = inst.writes.len();
+        // Scalar DXR state queries replace exactly one guest dword. Matrix
+        // loads may span rows but cannot cross the 3x4 transform into the ID.
+        let width_ok = match meta.kind {
+            RayMetaKind::BlasBaseZero => true,
+            RayMetaKind::ObjectToWorld(offset) => {
+                offset.is_multiple_of(4) && (offset as usize / 4).saturating_add(n) <= 12
+            }
+            _ => n == 1,
+        };
+        if !width_ok {
+            return Err(unsupported(
+                inst.machine.offset,
+                "ambiguous RayQuery metadata width",
+            ));
+        }
+        let zero = self.s.m.i32(0);
+        let vals = if meta.kind == RayMetaKind::BlasBaseZero {
+            vec![zero; n]
+        } else {
+            let done = self.s.m.new_block();
+            let mut edges = Vec::new();
+            let can_read = if meta.candidate {
+                guard
+            } else {
+                let valid = self.query_flag(self.cur, q.rq);
+                Some(if let Some(g) = guard {
+                    self.s.m.bin(self.cur, Bin::And, valid, g)
+                } else {
+                    valid
+                })
+            };
+            if let Some(g) = can_read {
+                let active = self.s.m.new_block();
+                self.s.m.terminate(self.cur, Term::CondBr(g, active, done));
+                edges.push((vec![zero; n], self.cur));
+                self.cur = active;
+            }
+            if meta.candidate {
+                let words =
+                    lift::emit_ray_meta_load(&mut self.s, self.cur, q.rq, true, meta.kind, n);
+                edges.push((words, self.cur));
+            } else {
+                for rq in std::iter::once(q.rq).chain(q.opaque) {
+                    let hit = self.s.m.new_block();
+                    let next = self.s.m.new_block();
+                    let status = rq.status(&mut self.s, self.cur);
+                    let one = self.s.m.i32(1);
+                    let tri = self.s.m.cmp(self.cur, pred::EQ, status, one);
+                    self.s.m.terminate(self.cur, Term::CondBr(tri, hit, next));
+                    let words = lift::emit_ray_meta_load(&mut self.s, hit, rq, false, meta.kind, n);
+                    self.s.m.terminate(hit, Term::Br(done));
+                    edges.push((words, hit));
+                    self.cur = next;
+                }
+                edges.push((vec![zero; n], self.cur));
+            }
+            self.s.m.terminate(self.cur, Term::Br(done));
+            self.cur = done;
+            (0..n)
+                .map(|k| {
+                    let phi = self.s.m.phi(done, self.s.t.i32);
+                    self.s
+                        .m
+                        .set_phi(phi, edges.iter().map(|(v, at)| (v[k], *at)).collect());
+                    phi
+                })
+                .collect()
+        };
+        for (&(reg, _), x) in inst.writes.iter().zip(vals) {
+            self.write(inst, reg, x, guard);
+        }
+        Ok(())
+    }
+}
