+    InstanceIndex,
+    /// `inst_addr + 0..44` (`ObjectToWorld3x4`, starting byte offset for 1..4 dword load).
+    ObjectToWorld(u32),
+    /// `tri_addr + 48` (`(GeometryIndex << 8) | flags` -> `GeometryIndex << 8`).
+    GeometryIndexShl8,
