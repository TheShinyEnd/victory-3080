+        let a = Analyzer::new(&p, &st, &res, &scalar);
+        let old = p.blocks[0].insts[0].write(Reg::V(2)).unwrap();
+        assert!(
+            !a.post_uses_match(old, &HashSet::from([0]), 0, &[], &HashSet::new(), |_, _| {
