+    InstanceId,
+    /// `inst_addr + 52` (bits `23:0` = `InstanceContributionToHitGroupIndex`).
+    InstanceContribution,
+    /// `inst_addr + 60` (`blas_base >> 8`, only feeds replaced `tri_addr` loads -> `0`).
+    BlasBaseZero,
