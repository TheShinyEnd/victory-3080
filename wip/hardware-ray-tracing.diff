+        // A traversal writes v2. The next block consumes it as the addend
+        // of v_fmac_f32 v2, v0, v1; neither encoded source names v2.
+        let words = [
+            0x7e04_0281u32,
+            0xbf82_0000,
+            (0x2b << 25) | (2 << 17) | (1 << 9) | 256,
+            0xbf81_0000,
+        ];
+        let bytes = words
+            .iter()
+            .flat_map(|w| w.to_le_bytes())
+            .collect::<Vec<_>>();
