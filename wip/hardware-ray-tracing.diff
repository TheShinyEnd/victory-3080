+                                        && !set_tag(
+                                            &mut tags,
+                                            &mut tag_facts,
+                                            &mut work,
+                                            wv,
+                                            BvhTag::AddrCarry,
+                                            v_facts.clone(),
+                                        )
+                                    {
+                                        meta_fail!("InstAddrLo carry clash at B{b}:{i}");
+                                    }
+                                }
+                            } else if let Some((ndw, imm_off)) = flat_or_smem_load_info(inst, v) {
