+// Hit probe for the DXR sidecar (diagnostics): one inline ray query per ray against a top-level structure.
+RaytracingAccelerationStructure scene : register(t0);
+struct Ray { float3 o; float tmin; float3 d; float tmax; };
+StructuredBuffer<Ray> rays : register(t1);
+struct Hit { float t; uint prim; uint inst; uint index; uint geom; uint kind; };
+RWStructuredBuffer<Hit> hits : register(u0);
+
+[numthreads(64, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    Ray r = rays[id.x];
+    RayDesc d;
+    d.Origin = r.o;
+    d.TMin = r.tmin;
+    d.Direction = r.d;
+    d.TMax = r.tmax;
+    RayQuery<RAY_FLAG_NONE> q;
+    q.TraceRayInline(scene, RAY_FLAG_NONE, 0xFF, d);
+    while (q.Proceed()) {
+        if (q.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE) {
+            q.CommitNonOpaqueTriangleHit();
+        }
+    }
+    Hit h;
+    h.t = 0; h.prim = 0; h.inst = 0; h.index = 0; h.geom = 0; h.kind = 0;
+    if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT) {
+        h.t = q.CommittedRayT();
+        h.prim = q.CommittedPrimitiveIndex();
+        h.inst = q.CommittedInstanceID();
+        h.index = q.CommittedInstanceIndex();
+        h.geom = q.CommittedGeometryIndex();
+        h.kind = 1;
+    }
+    hits[id.x] = h;
+}
